# Copy to .env for local dev, and set the production equivalents as build-time
# env vars wherever the site is built for deploy. Both are PUBLIC_ — Astro
# inlines them into the client bundle, so never put secrets here.

# Base URL of the Mielikkix backend API. Local dev points at the backend
# running on your machine; production must point at the real API host.
PUBLIC_API_URL=http://localhost:8000

# business_id of the "Mielikkix" business account that receives leads
# submitted through the marketing site's "Book a Free Demo" form (see
# website/src/pages/demo.astro). This is not secret -- it's the same kind of
# public identifier already embedded in every customer's chat widget script
# tag -- but it's still environment-specific: local dev and production point
# at two different business records (a local test one vs. the real one).
PUBLIC_MIELIKKIX_BUSINESS_ID=00000000-0000-0000-0000-000000000000

# Plausible Analytics site domain (e.g. "mielikkix.ai"), as registered at
# plausible.io. Layout.astro only renders the tracking snippet when this is
# set, so analytics stays off (no third-party script, no request) until a
# real Plausible account/domain exists. Leave unset for local dev.
# PUBLIC_PLAUSIBLE_DOMAIN=mielikkix.ai

# GA4 Measurement ID (e.g. "G-XXXXXXXXXX") for mielikkix.ai, from a GA4
# property at analytics.google.com. Even when set, GA only loads after a
# visitor clicks "Accept" in the cookie-consent banner (ConsentBanner.astro +
# src/lib/consent.ts, GDPR/ekomloven); unset = no GA at all. mielikkix.com/.no are not
# wired up -- this var is website/-only. Leave unset for local dev.
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: the chat widget bundle the site embeds. Unset = production
# (https://app.mielikkix.ai/widget.js). Locally, after `npm run build:widget` in
# apps/dashboard and `npm run dev` there: http://localhost:5173/widget.js
PUBLIC_WIDGET_URL=
