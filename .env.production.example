# Production environment template for the VPS.
# Copy this to `.env` on the VPS (next to docker-compose.yml) and fill in
# real values. Never commit the filled-in file.

# Database
# POSTGRES_USER/PASSWORD/DB feed docker-compose.yml's db service directly.
# DATABASE_URL is only used if the backend runs outside docker-compose —
# when run via `docker compose up`, the backend service's `environment:`
# block overrides this with the `db` container hostname instead.
POSTGRES_USER=mielikkix
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
POSTGRES_DB=mielikkix
DATABASE_URL=postgresql://mielikkix:REPLACE_WITH_A_RANDOM_PASSWORD@localhost:5432/mielikkix

# Explicit, not just left unset -- app/core/config.py's own default is
# already `False`, so omitting this line is functionally equivalent, but
# spelling it out here means a future edit to this file (or someone
# copy-pasting from a local dev .env, which sets DEBUG=true) can't
# silently flip it on without the change being obvious in a diff. DEBUG
# gates the voice agent's /dev/voice-test HTML page and relaxes auth.py's
# cookie `secure` flag -- true in production would expose an internal
# debug page and weaken session cookies.
DEBUG=false

# Auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_64_CHAR_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM providers — only set the keys for providers you use
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
# If DEFAULT_LLM_PROVIDER=ollama and Ollama runs on the VPS host (not in a
# container), use host.docker.internal, not localhost — localhost inside the
# backend container refers to the container itself, not the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional paid providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# File upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Email Notification Send
RESEND_API_KEY=
# Resend free/unverified tier can only deliver to your own Resend account
# email using the onboarding@resend.dev sandbox address. Verify a domain at
# resend.com/domains and point this at an address on that domain so real
# recipients (your users) actually receive emails.
NOTIFICATION_FROM_EMAIL=REPLACE_WITH_A_VERIFIED_DOMAIN_ADDRESS

# CORS (comma-separated list of allowed origins)
# Must be the real production frontend origin(s), not localhost, or the
# deployed frontend will get CORS-blocked calling this API.
#
# https://mielikkix.ai (the marketing site, website/) belongs on this list
# too, not just https://app.mielikkix.ai (the dashboard) -- confirmed live:
# app/core/cors.py's PublicRouteCORSMiddleware (any-origin allowlist) only
# covers /api/chat/message, /api/leads, and the two /api/agents/booking/*
# routes. Everything the marketing site's OWN embedded widgets/demo pages
# call falls through to this standard, origin-restricted CORSMiddleware
# instead: the sitewide Support Triage widget
# (POST /api/agents/support/chat/message, loaded on every page via
# website/src/layouts/Layout.astro), the Review & Reputation demo
# (POST /api/agents/reviews/demo), and the Voice Receptionist demo
# (/api/agents/voice/dev/*). Local dev's own CORS_ORIGINS already includes
# http://localhost:4321 (website/'s dev server) for exactly this reason --
# omitting the production equivalent here would silently CORS-block all
# three of those in production despite them working locally. This is why
# local dev must include http://localhost:4321 in CORS_ORIGINS too -- it's
# not just for testing the dashboard against a local API.
# (PublicRouteCORSMiddleware strips any Access-Control-Allow-Origin/Vary
# headers the CORSMiddleware below already added before setting its own, so
# an origin appearing here AND also calling one of ITS public routes no
# longer produces the duplicate-header CORS rejection it used to.)
CORS_ORIGINS=https://app.mielikkix.ai,https://mielikkix.ai,https://www.mielikkix.ai

# Dashboard URL — used to build links in emails (e.g. password reset).
# Must be the real production frontend URL, not localhost, or emailed links
# will point users at a dead address.
FRONTEND_URL=https://app.mielikkix.ai

# Platform admin — comma-separated emails allowed into the /admin dashboard.
# Log in (or register a business account) using one of these emails to see
# the platform admin dashboard at /admin. Left blank here (this file is
# now tracked in git, unlike your real VPS .env) -- fill in on the VPS
# itself, not here.
PLATFORM_ADMIN_EMAILS=
