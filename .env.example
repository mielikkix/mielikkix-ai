# Copy to .env and fill in your values. Never commit .env.

# Set to true for local development. Also gates the voice agent's /dev/*
# test routes (browser mic/speaker demo, CLI test script) -- see
# apps/api/app/api/agents_voice.py's _require_debug. Leave unset/false in
# production: those routes are an unauthenticated, real-money LLM proxy to
# anyone who finds the URL if left open.
DEBUG=true

# Database
# POSTGRES_USER/PASSWORD/DB feed docker-compose.yml's db service directly.
# Set a real random POSTGRES_PASSWORD in production — DATABASE_URL below
# must use the same value (docker-compose substitutes both from this file).
POSTGRES_USER=mielikkix
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_DB=mielikkix
DATABASE_URL=postgresql://mielikkix:change-me-to-a-random-password@localhost:5432/mielikkix

# Auth
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Encrypts per-business OAuth refresh tokens at rest (e.g. Booking
# Assistant's per-tenant Google Calendar connection) -- generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
TOKEN_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# LLM providers — only set the keys for providers you use
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Default model per provider, used when a business hasn't set its own model in
# Settings. Override these when a provider retires a model — that way it's an
# env change + restart, not a code deploy. (Groq retired llama-3.1-8b-instant,
# which 404'd every chat request until the default was changed.)
# List what your Groq key can actually serve:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_MODEL=llama3

# Per-agent model tier (packages/agent-core/mielikkix_agent_core/llm_client.py) --
# each Force agent picks its own provider explicitly at construction (see
# each agent's own `_llm_client = LLMClient(provider=...)`), independent of
# DEFAULT_LLM_PROVIDER above (which only matters for an agent that DOESN'T
# specify one, and for the Chat Widget's own separate rag/providers/
# get_llm_provider(), which is unaffected by all of this):
#   Voice Receptionist, SEO Copywriter (cheap/fast)   -> OpenAI
#   Booking Assistant, Support Triage (multi-turn reasoning + tool use) -> Anthropic Claude Sonnet
#   (reserved for a future genuinely very-complex workflow)             -> Anthropic Claude Opus
# Leave a key blank if you're not using that provider yet -- LLMClient only
# fails when a call actually reaches a provider with no key configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_OPUS_MODEL=claude-opus-5
# Only needed if your ANTHROPIC_API_KEY is "identity-linked" to more than
# one workspace -- such a key 400s on every request ("anthropic-workspace-id
# is required...") without this. A plain key from Console -> Settings ->
# API Keys doesn't need it. Find yours at console.anthropic.com's workspace
# settings page if you hit that error.
ANTHROPIC_WORKSPACE_ID=

# File upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Email Notification Send
RESEND_API_KEY=XYZ
# mielikkix.no is verified on Resend, so this can send to any recipient, not
# just the account owner's sandbox address. If RESEND_API_KEY is unset,
# notifications just log to the console instead of sending for real -- no
# domain verification needed for local dev.
NOTIFICATION_FROM_EMAIL=post@mielikkix.no


# CORS (comma-separated list of allowed origins)
# Production: CORS_ORIGINS=https://app.mielikkix.ai,https://mielikkix.ai
# :4321 = website/ (Astro)'s default dev server, for the voice-receptionist
# demo page's calls to /api/agents/voice/dev/*.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4321

# Dashboard URL — used to build links in emails (e.g. password reset)
FRONTEND_URL=http://localhost:5173

# Voice Receptionist agent (apps/agents/voice-receptionist) -- Twilio
# credentials, from your Twilio Console. Leave all three empty until you
# actually have a number: webhook signature validation is skipped only while
# TWILIO_ACCOUNT_SID/TWILIO_PHONE_NUMBER are ALSO empty (see
# apps/api/app/api/agents_voice.py). Outside DEBUG mode, setting either of
# those without TWILIO_AUTH_TOKEN fails startup on purpose (see
# apps/api/app/core/config.py) -- a half-configured Twilio deployment would
# otherwise leave the webhooks open to anyone who finds the URL.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# The public URL Twilio calls: your ngrok/cloudflared URL while testing
# locally (e.g. https://abcd1234.ngrok-free.app), the real api.mielikkix.ai
# URL in production.
VOICE_AGENT_PUBLIC_BASE_URL=http://localhost:8000
# Which business's FAQs/documents/products to ground the voice agent's
# replies against -- run scripts/setup_local_mielikkix_business.py to
# create a local dev business with real Mielikkix content and get one.
VOICE_AGENT_BUSINESS_ID=
# Opens the /dev/start and /dev/gather JSON routes to the public (the ones
# website/'s /demo/voice-receptionist page calls) WITHOUT needing DEBUG=true
# -- see apps/api/app/core/config.py for why DEBUG itself must stay off in
# production regardless (it also controls auth cookie security). Only set
# this true once you actually want the public demo live; it's a real,
# metered Groq cost per visitor turn.
VOICE_AGENT_PUBLIC_DEMO=false

# Booking Assistant agent (apps/agents/booking-assistant) -- books directly
# against Google Calendar (see that agent's CLAUDE.md for why, and for the
# real per-tenant OAuth flow this replaces in Phase 5). All three values
# below come from running scripts/connect_google_calendar.py once locally,
# after creating a Google Cloud OAuth 2.0 Client ID (Phase 0).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# "primary" = the connected account's own default calendar -- not a
# placeholder needing a real calendar ID filled in.
GOOGLE_CALENDAR_ID=primary

# Real per-tenant OAuth ("Web application" Client ID, separate from the
# Desktop-app one above) -- create in the same Google Cloud project:
# APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
# -> Web application -> Authorized redirect URI:
# http://localhost:8000/api/businesses/me/calendar/callback
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
# This app's own public URL -- must exactly match the redirect URI
# registered above (Google rejects the OAuth exchange otherwise). The real
# api.mielikkix.ai URL in production.
API_PUBLIC_BASE_URL=http://localhost:8000

# Support Triage agent (apps/agents/support-triage) -- powers the chat
# widget on website/ (Mielikkix's own marketing site), not a tenant's. Run
# scripts/setup_local_mielikkix_business.py to create a local dev business
# with real Mielikkix content and get an ID for this.
SUPPORT_AGENT_BUSINESS_ID=
# Below this confidence (0-1), Phase 1 declines to answer directly rather
# than guessing.
SUPPORT_AGENT_CONFIDENCE_THRESHOLD=0.6

# Platform admin — comma-separated emails allowed into the /admin dashboard
# (see apps/api/app/core/dependencies.py:require_platform_admin). This is the
# MielikkiX operator, not a tenant/business user.
PLATFORM_ADMIN_EMAILS=
