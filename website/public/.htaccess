<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(self)"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://plausible.io https://app.mielikkix.ai https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://api.frankfurter.dev https://api.mielikkix.ai https://plausible.io https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-ancestors 'self'"
</IfModule>

# Branded, translated 404 page (src/pages/404.astro) instead of Hostinger's
# stock English one -- QA 2026-10-05, BUG-14.
ErrorDocument 404 /404.html

# /company is a common guess for the About page (QA 2026-10-05, BUG-14).
<IfModule mod_alias.c>
    RedirectMatch 301 ^/company/?$ /about/
    RedirectMatch 301 ^/no/company/?$ /no/about/
    # @astrojs/sitemap writes /sitemap-index.xml (robots.txt points there); /sitemap.xml
    # is where people and tools look first (QA 2026-10-08, W-08).
    RedirectMatch 301 ^/sitemap\.xml$ /sitemap-index.xml
</IfModule>

# HTML is revalidated on every visit (a cheap 304 when unchanged), so a deploy's new
# ?v= script URLs (src/lib/publicAsset.ts) reach returning visitors at once instead of
# after the 7-day default. Old cached scripts broke every demo (QA 2026-10-08, W-01).
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
