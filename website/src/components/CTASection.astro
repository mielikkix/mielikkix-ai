---
import en from "../assets/i18n/en/common.json";

interface Props {
  heading: string;
  subheading?: string;
  headingKey?: string;
  subheadingKey?: string;
  /**
   * Where the second button points. A pricing page passes the OTHER pricing page, so it
   * never links to itself (QA 2026-10-01, B10: "See Pricing" on /pricing).
   */
  secondary?: "pricing" | "agent-pricing" | "widget-pricing";
}
const { heading, subheading, headingKey, subheadingKey, secondary = "pricing" } = Astro.props;
const SECONDARY = {
  pricing: { href: "/pricing/", key: "SEE_PRICING" },
  "agent-pricing": { href: "/agent-pricing/", key: "SEE_AGENT_PRICING" },
  "widget-pricing": { href: "/pricing/", key: "SEE_WIDGET_PRICING" },
} as const;
const second = SECONDARY[secondary];
---

<section class="mx-auto max-w-[1440px] px-6 py-16">
  <div class="brand-gradient relative overflow-hidden rounded-3xl px-8 py-14 text-center shadow-xl shadow-violet-200">
    <h2 class="font-display text-3xl font-bold text-white sm:text-4xl" data-i18n={headingKey}>{heading}</h2>
    {subheading && (
      <p class="mx-auto mt-3 max-w-xl text-indigo-50" data-i18n={subheadingKey}>{subheading}</p>
    )}
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="/demo/"
        data-i18n="BUTTONS.BOOK_DEMO"
        class="rounded-full bg-white px-7 py-3 text-sm font-semibold text-violet-700 shadow-sm transition-transform hover:scale-105"
      >
        {en.BUTTONS.BOOK_DEMO}
      </a>
      <a
        href={second.href}
        data-i18n={`BUTTONS.${second.key}`}
        class="rounded-full border border-white/60 px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10"
      >
        {en.BUTTONS[second.key]}
      </a>
    </div>
  </div>
</section>
