---
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import PageHero from "../components/PageHero.astro";
import Price from "../components/Price.astro";
import en from "../assets/i18n/en/pricing.json";

const plans = en.PLANS;
const faqs = en.FAQ.ITEMS;

// One outline icon per plan tier, in the same order as PLANS (Free, Basic, Business, Growth).
const planIconPaths = [
  "M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z M18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z",
  "m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z",
  "M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0",
  "M2.25 18 9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0-5.94-2.28m5.94 2.28-2.28 5.941",
];

// Per-tier accent used for the icon badge + glow behind it on non-featured cards.
const planAccents = [
  { iconBg: "bg-emerald-50", iconText: "text-emerald-600", blob: "bg-emerald-300" },
  { iconBg: "bg-sky-50", iconText: "text-sky-600", blob: "bg-sky-300" },
  { iconBg: "bg-indigo-50", iconText: "text-violet-700", blob: "bg-violet-300" },
  { iconBg: "bg-amber-50", iconText: "text-amber-600", blob: "bg-amber-300" },
];
---

<Layout
  title={en.SEO.TITLE}
  description={en.SEO.DESCRIPTION}
  path="/pricing"
  page="pricing"
  titleKey="SEO.TITLE"
  descriptionKey="SEO.DESCRIPTION"
>
  <PageHero
    line1={en.PAGE_HERO.LINE1}
    line2={en.PAGE_HERO.LINE2}
    subheading={en.PAGE_HERO.SUBHEADING}
    line1Key="PAGE_HERO.LINE1"
    line2Key="PAGE_HERO.LINE2"
    subheadingKey="PAGE_HERO.SUBHEADING"
  />

  <section class="mx-auto max-w-[1440px] px-6 py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        plans.map((plan, i) => (
          <div
            class:list={[
              "flex flex-col rounded-3xl border p-7",
              plan.FEATURED
                ? "brand-gradient border-transparent text-white shadow-2xl shadow-violet-200 lg:-translate-y-3"
                : "border-slate-300 bg-white",
            ]}
          >
            <div class="relative mb-4 flex h-12 w-12 items-center justify-center">
              {!plan.FEATURED && (
                <span class:list={["absolute inset-0 rounded-full opacity-40 blur-lg", planAccents[i].blob]} />
              )}
              <div
                class:list={[
                  "relative flex h-11 w-11 items-center justify-center rounded-xl",
                  plan.FEATURED ? "bg-white/20" : planAccents[i].iconBg,
                ]}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class:list={["h-5 w-5", plan.FEATURED ? "text-white" : planAccents[i].iconText]}
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={planIconPaths[i]} />
                </svg>
              </div>
            </div>
            {plan.FEATURED && (
              <span class="mb-3 inline-block w-fit rounded-full bg-white/20 px-3 py-1 text-xs font-semibold" data-i18n="MOST_POPULAR_BADGE">
                {en.MOST_POPULAR_BADGE}
              </span>
            )}
            <h2
              class:list={["font-display text-xl font-bold", plan.FEATURED ? "text-white" : "text-slate-900"]}
              data-i18n={`PLANS.${i}.NAME`}
            >
              {plan.NAME}
            </h2>
            <p class:list={["mt-1 text-sm", plan.FEATURED ? "text-indigo-50" : "text-slate-500"]} data-i18n={`PLANS.${i}.TAGLINE`}>
              {plan.TAGLINE}
            </p>
            <p class="mt-5">
              <span class:list={["font-display text-3xl font-extrabold", plan.FEATURED ? "text-white" : "text-slate-900"]}>
                <Price amount={plan.PRICE_USD} />
              </span>
              <span class:list={["ml-1 text-sm", plan.FEATURED ? "text-indigo-100" : "text-slate-400"]} data-i18n={`PLANS.${i}.PERIOD`}>
                {plan.PERIOD}
              </span>
            </p>
            <p
              class:list={[
                "mt-2 inline-block w-fit rounded-lg px-2.5 py-1 text-xs font-semibold",
                plan.FEATURED ? "bg-white/10 text-white" : "bg-slate-50 text-slate-600",
              ]}
              data-i18n={`PLANS.${i}.FEATURES.1`}
            >
              {plan.FEATURES[1]}
            </p>
            <a
              href="/demo"
              data-i18n={`PLANS.${i}.CTA`}
              class:list={[
                "mt-6 rounded-full px-4 py-2.5 text-center text-sm font-semibold shadow-sm transition-transform hover:scale-105",
                plan.FEATURED
                  ? "bg-white text-violet-700 shadow-violet-900/10"
                  : "brand-gradient text-white shadow-violet-200",
              ]}
            >
              {plan.CTA}
            </a>
            <p
              class:list={[
                "mt-2 text-center text-[11px] font-medium",
                plan.FEATURED ? "text-indigo-100" : "text-emerald-600",
                plan.PRICE_USD === 0 && "invisible",
              ]}
              data-i18n="SAVINGS_BADGE"
              aria-hidden={plan.PRICE_USD === 0 ? "true" : undefined}
            >
              {en.SAVINGS_BADGE}
            </p>
            <ul class="mt-7 space-y-3 text-sm">
              {
                plan.FEATURES.map((feature, j) => (
                  <li class:list={["flex gap-2", plan.FEATURED ? "text-indigo-50" : "text-slate-600"]}>
                    <span class:list={plan.FEATURED ? "text-blue-200" : "text-violet-500"}>✓</span>
                    <span data-i18n={`PLANS.${i}.FEATURES.${j}`}>{feature}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!--
    Force Crew add-ons: a separate purchase axis from the plans above (see
    packages/billing/README.md -- individual agent / 3-agent bundle / Full
    Crew). Deliberately no dollar amounts here yet: that pricing hasn't
    actually been decided anywhere in the codebase, and inventing numbers
    on a live pricing page would be worse than not showing them.
  -->
  <section class="border-t border-slate-100 bg-white py-16">
    <div class="mx-auto max-w-[1440px] px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold text-slate-900">Add Force Crew agents</h2>
        <p class="mt-3 text-sm text-slate-500">
          The plans above cover the Chat Widget. The Force Crew (Voice Receptionist, Booking
          Assistant, and more) are separate add-ons on top of any plan --
          <a href="/agents" class="text-violet-600 underline">see the full crew</a>.
        </p>
      </div>
      <div class="mx-auto mt-10 grid max-w-4xl gap-6 sm:grid-cols-3">
        {
          [
            { name: "Individual Agent", description: "Add one Force Crew agent to your plan." },
            { name: "3-Agent Bundle", description: "Pick any 3 agents at a bundled rate." },
            { name: "Full Crew", description: "All 10 agents, one price." },
          ].map((tier) => (
            <div class="rounded-3xl border border-slate-200 bg-white p-6 text-center">
              <h3 class="font-display font-bold text-slate-900">{tier.name}</h3>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-500">{tier.description}</p>
              <p class="mt-4 text-sm font-semibold text-violet-600">Pricing coming soon</p>
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-center text-xs text-slate-400">
        Want to be notified when Force Crew pricing is live?{" "}
        <a href="/demo" class="text-violet-600 underline">Get in touch</a>.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-slate-100 bg-slate-50 py-16">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="font-display text-center text-3xl font-bold text-slate-900" data-i18n="FAQ.HEADING">
        {en.FAQ.HEADING}
      </h2>
      <div class="mt-10 space-y-4">
        {
          faqs.map((item, i) => (
            <details class="group rounded-2xl border border-slate-300 bg-white p-5 open:shadow-sm">
              <summary class="flex cursor-pointer list-none items-center justify-between font-display font-semibold text-slate-900">
                <span data-i18n={`FAQ.ITEMS.${i}.Q`}>{item.Q}</span>
                <span class="ml-4 text-violet-500 transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-slate-500" data-i18n={`FAQ.ITEMS.${i}.A`}>
                {item.A}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection
    heading={en.CTA.HEADING}
    subheading={en.CTA.SUBHEADING}
    headingKey="CTA.HEADING"
    subheadingKey="CTA.SUBHEADING"
  />
</Layout>
