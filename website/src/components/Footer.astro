---
import en from "../assets/i18n/en/common.json";
import enFooter from "../assets/i18n/en/footer.json";

const year = new Date().getFullYear();

const productLinks = [
  { href: "/features", label: en.NAV.FEATURES, key: "NAV.FEATURES" },
  { href: "/pricing", label: en.NAV.PRICING, key: "NAV.PRICING" },
  { href: "/demo", label: en.BUTTONS.BOOK_DEMO, key: "BUTTONS.BOOK_DEMO" },
];
---

<footer class="border-t border-slate-100 bg-slate-50">
  <div class="mx-auto max-w-[1440px] px-6 py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <a href="/" class="font-display text-xl font-bold tracking-tight">
          Mielikki<span class="brand-gradient-text">X</span>
        </a>
        <p class="mt-3 max-w-xs text-sm text-slate-500" data-i18n="FOOTER.TAGLINE">
          {enFooter.FOOTER.TAGLINE}
        </p>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold text-slate-900" data-i18n="FOOTER.PRODUCT_HEADING">
          {enFooter.FOOTER.PRODUCT_HEADING}
        </h3>
        <ul class="mt-4 space-y-2">
          {
            productLinks.map((link) => (
              <li>
                <a href={link.href} data-i18n={link.key} class="text-sm text-slate-500 hover:text-violet-600">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold text-slate-900" data-i18n="FOOTER.GET_STARTED_HEADING">
          {enFooter.FOOTER.GET_STARTED_HEADING}
        </h3>
        <p class="mt-4 text-sm text-slate-500" data-i18n="FOOTER.GET_STARTED_TEXT">
          {enFooter.FOOTER.GET_STARTED_TEXT}
        </p>
        <a
          href="/demo"
          data-i18n="BUTTONS.BOOK_DEMO"
          class="brand-gradient mt-4 inline-block rounded-full px-5 py-2.5 text-sm font-semibold text-white"
        >
          {en.BUTTONS.BOOK_DEMO}
        </a>
      </div>
    </div>

    <div class="mt-10 border-t border-slate-200 pt-6 text-sm text-slate-400" data-i18n="FOOTER.COPYRIGHT">
      {enFooter.FOOTER.COPYRIGHT.replace("{{YEAR}}", String(year))}
    </div>
  </div>
</footer>
