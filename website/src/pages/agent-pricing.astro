---
// Per-agent pricing: one <ProductPricing> section per agent (tier cards, comparison
// table, price/usage chart, FAQ), all read from src/data/pricing.ts. The Chat Widget
// has its own page (/pricing) and is linked from here.
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import PageHero from "../components/PageHero.astro";
import Bi from "../components/pricing/Bi.astro";
import BillingToggle from "../components/pricing/BillingToggle.astro";
import ProductPricing from "../components/pricing/ProductPricing.astro";
import PricingLegalNote from "../components/pricing/PricingLegalNote.astro";
import { getProduct, type ProductId } from "../data/pricing";
import { pricingProductNode } from "../lib/offeringSchema";
import en from "../assets/i18n/en/agent-pricing.json";

const agentIds: ProductId[] = [
  "voice-receptionist",
  "booking-assistant",
  "support-triage",
  "review-reputation",
  "seo-audit",
  "custom-agents",
];
const agents = agentIds.map(getProduct);
---

<Layout
  title={en.SEO.TITLE}
  description={en.SEO.DESCRIPTION}
  path="/agent-pricing"
  structuredDataNodes={agentIds.map((id) => pricingProductNode(id, `/agent-pricing#${id}`))}
  page="agent-pricing"
  titleKey="SEO.TITLE"
  descriptionKey="SEO.DESCRIPTION"
>
  <PageHero
    line1={en.PAGE_HERO.LINE1}
    line2={en.PAGE_HERO.LINE2}
    subheading={en.PAGE_HERO.SUBHEADING}
    line1Key="PAGE_HERO.LINE1"
    line2Key="PAGE_HERO.LINE2"
    subheadingKey="PAGE_HERO.SUBHEADING"
  />

  <nav class="mx-auto max-w-5xl px-6 pt-10" aria-labelledby="agent-nav-label">
    <p id="agent-nav-label" class="text-center text-xs font-semibold uppercase tracking-wide text-slate-400" data-i18n="NAV_LABEL">
      {en.NAV_LABEL}
    </p>
    <ul class="mt-3 flex flex-wrap justify-center gap-2">
      {
        agents.map((product) => (
          <li>
            <a
              href={`#${product.id}`}
              class="inline-block rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-slate-700 hover:border-violet-300 hover:text-violet-700"
            >
              <span aria-hidden="true">{product.emoji}</span> <Bi text={product.name} />
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-8">
      <BillingToggle />
    </div>
  </nav>

  {agents.map((product) => <ProductPricing productId={product.id} />)}

  <p class="pb-10 text-center text-sm text-slate-500">
    <span data-i18n="CHAT_NOTE">{en.CHAT_NOTE}</span>
    <a href="/pricing#chat-widget" class="ml-1 font-semibold text-violet-600 hover:text-violet-700" data-i18n="CHAT_LINK">
      {en.CHAT_LINK}
    </a>
  </p>

  <PricingLegalNote />

  <CTASection heading={en.CTA.HEADING} subheading={en.CTA.SUBHEADING} headingKey="CTA.HEADING" subheadingKey="CTA.SUBHEADING" />
</Layout>
