---
// Currency defaults to whatever the selected language implies (see SUPPORTED_LANGUAGES in
// translationService.ts) — EUR for English, NOK for Norwegian — but CurrencySwitcher lets a
// visitor override that independently (e.g. view USD pricing without switching language).
import LanguageSwitcher from "./LanguageSwitcher.astro";
import CurrencySwitcher from "./CurrencySwitcher.astro";
import en from "../assets/i18n/en/common.json";

const navLinks = [
  { href: "/agents", label: en.NAV.AGENTS, key: "NAV.AGENTS" },
  { href: "/features", label: en.NAV.FEATURES, key: "NAV.FEATURES" },
  { href: "/blog", label: en.NAV.BLOG, key: "NAV.BLOG" },
];

// Pricing is two separate products now (the Chat Widget's own plan tiers,
// and Force agents like SEO Audit & Optimize, sold on their own axis --
// see apps/agents/seo-audit/CLAUDE.md's "Standalone agent billing"
// decision) -- a hover/click dropdown on desktop instead of one flat link,
// per business direction 2026-09-19.
const pricingLinks = [
  { href: "/pricing", label: en.NAV.PRICING_CHATBOT, key: "NAV.PRICING_CHATBOT" },
  { href: "/agent-pricing", label: en.NAV.PRICING_AGENTS, key: "NAV.PRICING_AGENTS" },
];
// Production (static-host directory serving) resolves "/features" to
// "/features/", while the Astro dev server keeps it bare -- strip a
// trailing slash so the active-link check matches in both.
const currentPath = Astro.url.pathname.replace(/(.)\/$/, "$1");
---

<header class="sticky top-0 z-50 border-b border-slate-100 bg-white/80 backdrop-blur">
  <input type="checkbox" id="nav-toggle" class="peer hidden" />

  <div class="mx-auto flex max-w-[1440px] items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-1.5 font-display text-xl font-bold tracking-tight">
      <img src="/favicon.png" alt="" width="28" height="28" class="h-7 w-7 rounded-full" />
      <span>Mielikki<span class="brand-gradient-text">X</span></span>
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-i18n={link.key}
            class:list={[
              "text-sm font-medium transition-colors hover:text-violet-600",
              currentPath === link.href ? "text-violet-600" : "text-slate-600",
            ]}
          >
            {link.label}
          </a>
        ))
      }

      <!--
        Pricing is two separate products (Chat Widget plans vs. Force
        agents like SEO Audit & Optimize, sold on their own axis) --
        hover opens this on desktop; group-focus-within keeps it reachable
        by keyboard. Mobile gets both links listed flat below instead,
        since hover doesn't exist on touch.
      -->
      <div class="group relative">
        <button
          type="button"
          aria-haspopup="true"
          class:list={[
            "flex items-center gap-1 text-sm font-medium transition-colors hover:text-violet-600",
            pricingLinks.some((l) => l.href === currentPath) ? "text-violet-600" : "text-slate-600",
          ]}
        >
          <span data-i18n="NAV.PRICING">{en.NAV.PRICING}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
        <div class="invisible absolute left-1/2 top-full z-10 w-52 -translate-x-1/2 pt-3 opacity-0 transition-opacity duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <div class="rounded-2xl border border-slate-100 bg-white p-2 shadow-lg shadow-slate-200/60">
            {
              pricingLinks.map((link) => (
                <a
                  href={link.href}
                  data-i18n={link.key}
                  class:list={[
                    "block rounded-lg px-3 py-2 text-sm font-medium transition-colors hover:bg-slate-50",
                    currentPath === link.href ? "text-violet-600" : "text-slate-600",
                  ]}
                >
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <LanguageSwitcher />
      <CurrencySwitcher />
      <a
        href="/demo"
        data-i18n="BUTTONS.BOOK_DEMO"
        class="brand-gradient rounded-full px-5 py-2.5 text-sm font-semibold text-white shadow-sm shadow-violet-200 transition-transform hover:scale-105"
      >
        {en.BUTTONS.BOOK_DEMO}
      </a>
    </nav>

    <label
      for="nav-toggle"
      class="grid h-10 w-10 cursor-pointer place-items-center rounded-lg text-slate-700 md:hidden"
      aria-label="Toggle menu"
      data-i18n-attr="aria-label:A11Y.TOGGLE_MENU"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </label>
  </div>

  <div class="hidden flex-col gap-3 border-t border-slate-100 bg-white px-6 py-4 peer-checked:flex md:hidden">
    {
      navLinks.map((link) => (
        <a href={link.href} data-i18n={link.key} class="rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
          {link.label}
        </a>
      ))
    }
    <div class="mt-1 border-t border-slate-100 pt-3">
      <p class="px-3 text-xs font-semibold uppercase tracking-wide text-slate-400" data-i18n="NAV.PRICING">
        {en.NAV.PRICING}
      </p>
      {
        pricingLinks.map((link) => (
          <a href={link.href} data-i18n={link.key} class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="flex flex-wrap items-center gap-2 px-3">
      <LanguageSwitcher />
      <CurrencySwitcher />
    </div>
    <a
      href="/demo"
      data-i18n="BUTTONS.BOOK_DEMO"
      class="brand-gradient mt-2 rounded-full px-5 py-2.5 text-center text-sm font-semibold text-white"
    >
      {en.BUTTONS.BOOK_DEMO}
    </a>
  </div>
</header>
