---

<Layout
  title="The Mielikkix Force Crew"
  description="10 AI agents for small businesses -- voice, booking, support, reviews, social, and more. See what's live now and what's coming."
  path="/agents"
>
  <PageHero
    line1="Meet the"
    line2="Force Crew"
    subheading="10 AI agents for small businesses. Two are live for preview today -- the rest are on the way."
  />

  <section class="mx-auto max-w-[1440px] px-6 py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        agents.map((agent) => {
          const isLive = agent.status === "preview";
          const Wrapper = isLive ? "a" : "div";
          return (
            <Wrapper
              {...(isLive ? { href: agent.href } : {})}
              class:list={[
                "flex flex-col rounded-3xl border p-7 transition-transform",
                isLive
                  ? "border-transparent bg-white shadow-lg shadow-violet-100 hover:-translate-y-1"
                  : "border-slate-200 bg-slate-50/60",
              ]}
            >
              <div class="mb-4 flex items-start justify-between">
                <div
                  class:list={[
                    "flex h-11 w-11 items-center justify-center rounded-xl",
                    isLive ? "brand-gradient" : "bg-slate-200",
                  ]}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class:list={["h-5 w-5", isLive ? "text-white" : "text-slate-500"]}
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d={agent.icon} />
                  </svg>
                </div>
                <span
                  class:list={[
                    "rounded-full px-2.5 py-1 text-[11px] font-semibold",
                    isLive ? "bg-emerald-50 text-emerald-700" : "bg-slate-200 text-slate-500",
                  ]}
                >
                  {isLive ? "Live Preview" : "Coming Soon"}
                </span>
              </div>
              <h2 class:list={["font-display text-lg font-bold", isLive ? "text-slate-900" : "text-slate-600"]}>
                {agent.name}
              </h2>
              <p class:list={["mt-1.5 text-sm leading-relaxed", isLive ? "text-slate-500" : "text-slate-400"]}>
                {agent.tagline}
              </p>
              {isLive && (
                <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">
                  Talk to it now &rarr;
                </span>
              )}
            </Wrapper>
          );
        })
      }
    </div>

    <div class="mt-14 rounded-3xl border border-slate-100 bg-slate-50 p-8 text-center">
      <h2 class="font-display text-xl font-bold text-slate-900">Want early access as each agent ships?</h2>
      <p class="mx-auto mt-2 max-w-lg text-sm text-slate-500">
        Tell us which agents matter most to your business and we'll reach out as they're ready.
      </p>
      <a
        href="/demo"
        class="brand-gradient mt-5 inline-block rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm shadow-violet-200 transition-transform hover:scale-105"
      >
        Get in Touch
      </a>
    </div>
  </section>
</Layout>
