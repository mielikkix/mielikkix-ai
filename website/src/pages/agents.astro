const howItWorks = [
  { step: "01", title: "Tell Us Your Workflow", description: "Tell us what your team does manually today." },
  {
    step: "02",
    title: "We Design the AI Solution",
    description: "We design the agent, workflow, integrations, and automation around your requirements.",
  },
  { step: "03", title: "Launch & Automate", description: "Deploy the solution and let AI handle the repetitive work." },
];
---

<Layout
  title="AI Agents for Your Business"
  description="AI Chatbot, Voice Receptionist, and Booking Assistant -- ready-to-use AI solutions from Mielikkix. Plus custom AI agent development for whatever your business needs to automate."
  path="/agents"
>
  <PageHero
    line1="AI Agents Built"
    line2="Around Your Business"
    subheading="Automate customer conversations, phone calls, bookings, support, and business workflows with AI agents designed for your business."
  >
    <div slot="extra" class="mt-8">
      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="#core-solutions"
          class="rounded-full bg-white px-7 py-3 text-sm font-semibold text-violet-700 shadow-sm transition-transform hover:scale-105"
        >
          Explore AI Solutions
        </a>
        <a
          href="/demo"
          class="rounded-full border border-white/60 px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10"
        >
          Build a Custom AI Agent
        </a>
      </div>
      <p class="mx-auto mt-5 max-w-md text-sm text-indigo-50">
        Start with our ready-to-use AI solutions or request a custom agent tailored to your workflow.
      </p>
    </div>
  </PageHero>

  <!-- Core AI Solutions -- the visual focus of the page -->
  <section id="core-solutions" class="mx-auto max-w-[1440px] px-6 py-20 scroll-mt-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold text-slate-900 sm:text-4xl">Start With Our Core AI Solutions</h2>
      <p class="mt-4 text-slate-500">
        Ready-to-demo AI solutions designed to automate the most important customer-facing workflows.
      </p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-3">
      {
        coreSolutions.map((agent) => (
          <a
            href={agent.href}
            class="group flex flex-col rounded-3xl border border-transparent bg-white p-9 shadow-lg shadow-violet-100 transition-all hover:-translate-y-1.5 hover:shadow-xl hover:shadow-violet-200"
          >
            <div class="flex items-start justify-between">
              <div class="brand-gradient flex h-16 w-16 items-center justify-center rounded-2xl shadow-sm shadow-violet-200">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={agent.icon} />
                </svg>
              </div>
              <span class:list={["rounded-full px-3 py-1 text-xs font-semibold", agent.statusClass]}>{agent.status}</span>
            </div>
            <h3 class="font-display mt-6 text-2xl font-bold text-slate-900">{agent.name}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-500">{agent.description}</p>
            <span class="brand-gradient mt-7 inline-flex items-center justify-center gap-1.5 rounded-full px-6 py-3 text-sm font-semibold text-white shadow-sm shadow-violet-200 transition-transform group-hover:scale-105">
              {agent.cta} &rarr;
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- More AI agents we've built -- real, working previews, but visually secondary to the three core solutions above -->
  <section class="mx-auto max-w-[1440px] px-6 pb-20">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-2xl font-bold text-slate-900 sm:text-3xl">More AI Agents We've Built</h2>
      <p class="mt-3 text-slate-500">Explore additional AI automation capabilities developed by Mielikkix.</p>
    </div>

    <div class="mx-auto mt-10 grid max-w-3xl gap-5 sm:grid-cols-2">
      {
        additionalAgents.map((agent) => (
          <a
            href={agent.href}
            class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 transition-shadow hover:shadow-md"
          >
            <div class="mb-4 flex items-start justify-between">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={agent.icon} />
                </svg>
              </div>
              <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold text-slate-500">Demo Available</span>
            </div>
            <h3 class="font-display text-lg font-semibold text-slate-900">{agent.name}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-500">{agent.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-violet-600">View Demo &rarr;</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Custom AI agent development -- capability showcase, deliberately NOT framed as a product
       roadmap. No "Coming Soon" language anywhere near this list: per current business
       direction, these are examples of what Mielikkix can build to order, not agents already
       in development, so the copy stays "custom agent example," never "coming soon." -->
  <section class="bg-slate-50 py-20">
    <div class="mx-auto max-w-[1440px] px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold text-slate-900 sm:text-4xl">Need an AI Agent Built for Your Business?</h2>
        <p class="mt-4 text-slate-500">
          Every business has different workflows. Mielikkix can design and develop custom AI agents that automate the
          tasks specific to your business.
        </p>
      </div>

      <p class="mt-12 text-center text-xs font-semibold uppercase tracking-wider text-slate-400">Custom AI Agent Examples</p>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          customAgentExamples.map((example) => (
            <div class="flex items-start gap-4 rounded-2xl border border-slate-200 bg-white p-5">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-indigo-50">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={example.icon} />
                </svg>
              </div>
              <div>
                <h3 class="font-display text-sm font-semibold text-slate-900">{example.name}</h3>
                <p class="mt-1 text-sm leading-relaxed text-slate-500">{example.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Custom agent CTA -->
  <section class="mx-auto max-w-[1440px] px-6 py-16">
    <div class="brand-gradient relative overflow-hidden rounded-3xl px-8 py-14 text-center shadow-xl shadow-violet-200">
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">Tell Us What You Want to Automate</h2>
      <p class="mx-auto mt-3 max-w-xl text-indigo-50">
        Don't see the AI agent you need? We can design a solution around your business process.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/demo"
          class="rounded-full bg-white px-7 py-3 text-sm font-semibold text-violet-700 shadow-sm transition-transform hover:scale-105"
        >
          Request a Custom AI Agent
        </a>
        <a
          href="/demo"
          class="rounded-full border border-white/60 px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10"
        >
          Book a Free Demo
        </a>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-[1440px] px-6 pb-24">
    <h2 class="font-display text-center text-3xl font-bold text-slate-900 sm:text-4xl">How It Works</h2>
    <div class="mt-12 grid gap-8 md:grid-cols-3">
      {
        howItWorks.map((s) => (
          <div class="relative rounded-2xl bg-white p-8 shadow-sm shadow-slate-100">
            <span class="font-display brand-gradient-text text-4xl font-extrabold">{s.step}</span>
            <h3 class="font-display mt-4 text-lg font-semibold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">{s.description}</p>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
