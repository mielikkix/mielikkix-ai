# Environment
.env
*.env.local
# .env.production.example is deliberately NOT ignored -- it's a template
# (placeholder values only, e.g. REPLACE_WITH_A_RANDOM_PASSWORD, see its
# own header comment: "Never commit the FILLED-IN file", meaning the
# template itself is meant to be tracked, the same way .env.example is).
# Confirmed live: this was accidentally gitignored, so a real fix to it
# (e.g. correcting CORS_ORIGINS for production) never actually reached
# anyone deploying from a fresh clone of this repo.

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
test.db

# Node
node_modules/
apps/dashboard/dist/
apps/dashboard/public/widget.js

# Vite's dep pre-bundling cache. Normally lives under node_modules/ (already
# ignored above), but Vite falls back to a project-level .vite/ when it can't
# resolve node_modules -- e.g. if package.json goes missing while the dev
# server is running.
.vite/

# Astro generated types (in case astro is ever run from the repo root)
.astro/

# Uploads
apps/api/uploads/

# Local dev server logs
*.log

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Office lock files
~$*

# Marketing collateral (pitch decks etc.) -- not app code, kept local only
marketing/
