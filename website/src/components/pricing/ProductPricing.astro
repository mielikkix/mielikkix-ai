---
// Full pricing block for one product: tier cards, comparison table, price/usage chart
// and FAQ. Everything comes from src/data/pricing.ts -- no prices in this file.
// Monthly/yearly display is switched by BillingToggle.astro (global.css hides one).
import Bi from "./Bi.astro";
import PricingChart from "./PricingChart.astro";
import {
  TIER_NAMES,
  PRICING_META,
  formatMonthly,
  formatYearly,
  formatNok,
  priceParts,
  formatNumber,
  formatValue,
  getProduct,
  withVat,
  type Lang,
  type ProductId,
  type Tier,
  type Text,
} from "../../data/pricing";

interface Props {
  productId: ProductId;
  /** Show the product name/tagline heading (off when a page already has one). */
  showHeading?: boolean;
  headingLevel?: 2 | 3;
}
const { productId, showHeading = true, headingLevel = 2 } = Astro.props;
const product = getProduct(productId);
const tiers = product.tiers;
const Heading: "h2" | "h3" = headingLevel === 3 ? "h3" : "h2";
const langs: Lang[] = ["en", "no"];
const T = (en: string, no: string): Text => ({ en, no });

const L = {
  recommended: T("⭐ Recommended", "⭐ Anbefalt"),
  managed: T("Managed", "Managed"),
  soon: T("Coming soon", "Kommer snart"),
  monthsFree: T("2 months free", "2 måneder gratis"),
  overage: T("Overage", "Tillegg ved overforbruk"),
  term: T("Minimum term", "Bindingstid"),
  months: T("months", "måneder"),
  none: T("None", "Ingen"),
  price: T("Price", "Pris"),
  priceVat: T("Price incl. 25% MVA", "Pris inkl. 25 % mva."),
  compare: T("Compare plans", "Sammenlign planene"),
  feature: T("Feature", "Funksjon"),
  faq: T("Questions about pricing", "Spørsmål om priser"),
  included: T("Included", "Inkludert"),
  notIncluded: T("Not included", "Ikke inkludert"),
};

function ctaText(tier: Tier): Text {
  if (tier.priceNokMonthly === null) return T("Get started free", "Kom i gang gratis");
  if (productId === "custom-agents" || tier.managed) return T("Talk to us", "Snakk med oss");
  return T("Book a demo", "Book en demo");
}

function overageText(tier: Tier, lang: Lang): string {
  if (!tier.overage) return lang === "no" ? "Ingen tilleggskostnader" : "No overage charges";
  const price = formatNumber(tier.overage.priceNok, lang).replace(/^(\d+)$/, lang === "no" ? "$1,00" : "$1.00");
  return lang === "no" ? `${price} kr/${tier.overage.unit.no}` : `${price} kr/${tier.overage.unit.en}`;
}

// Comparison rows: every limit (by English label), then every feature, in first-seen order.
const limitLabels: Text[] = [];
for (const tier of tiers)
  for (const inc of tier.included)
    if (!limitLabels.some((l) => l.en === inc.label.en)) limitLabels.push(inc.label);
const featureRows: Text[] = [];
for (const tier of tiers)
  for (const f of tier.features)
    if (!featureRows.some((r) => r.en === f.en)) featureRows.push({ en: f.en, no: f.no });
const hasOverage = tiers.some((t) => t.overage);
const hasTerm = tiers.some((t) => t.minTermMonths);
---

<section id={product.id} class="scroll-mt-28 mx-auto max-w-[1440px] px-6 py-14">
  {
    showHeading && (
      <div class="mx-auto max-w-2xl text-center">
        <Heading class="font-display text-3xl font-bold text-slate-900 sm:text-4xl">
          <span aria-hidden="true">{product.emoji}</span> <Bi text={product.name} />
        </Heading>
        <p class="mt-3 text-slate-500"><Bi text={product.tagline} /></p>
      </div>
    )
  }

  <!-- Tier cards -->
  <div
    class:list={[
      "mx-auto mt-10 grid gap-6 sm:grid-cols-2",
      tiers.length === 4 ? "lg:grid-cols-4" : "max-w-5xl lg:grid-cols-3",
    ]}
  >
    {
      tiers.map((tier) => {
        const featured = !!tier.recommended;
        const muted = featured ? "text-indigo-100" : "text-slate-500";
        return (
          <div
            class:list={[
              "flex flex-col rounded-3xl border p-7",
              featured ? "brand-gradient border-transparent text-white shadow-2xl shadow-violet-200" : "border-slate-300 bg-white",
            ]}
          >
            <div class="mb-3 flex flex-wrap gap-2">
              {featured && (
                <span class="rounded-full bg-white/20 px-3 py-1 text-xs font-semibold"><Bi text={L.recommended} /></span>
              )}
              {tier.managed && (
                <span class:list={["rounded-full px-3 py-1 text-xs font-semibold", featured ? "bg-white/20" : "bg-amber-50 text-amber-700"]}>
                  <Bi text={L.managed} />
                </span>
              )}
            </div>
            <h3 class:list={["font-display text-xl font-bold", featured ? "text-white" : "text-slate-900"]}>
              <Bi text={TIER_NAMES[tier.id]} />
            </h3>

            <p class:list={["mt-4 leading-tight", featured ? "text-white" : "text-slate-900"]}>
              {langs.map((lang) =>
                (["month", "year"] as const).map((period) => {
                  const p = priceParts(tier, lang, period);
                  return (
                    <span class:list={[lang === "no" ? "i18n-no" : "i18n-en", period === "year" ? "billing-yearly" : "billing-monthly"]}>
                      {p.prefix && <span class:list={["text-sm font-medium", muted]}>{p.prefix}</span>}
                      <span class="font-display text-3xl font-extrabold">{p.amount}</span>
                      {p.suffix && <span class:list={["ml-1 text-sm", muted]}>{p.suffix}</span>}
                    </span>
                  );
                }),
              )}
            </p>
            {tier.priceNokMonthly !== null && (
              <p class:list={["billing-yearly mt-1 text-xs font-semibold", featured ? "text-white" : "text-emerald-600"]}>
                <Bi text={L.monthsFree} />
              </p>
            )}
            {tier.minTermMonths && (
              <p class:list={["mt-1 text-xs", muted]}>
                <span class="i18n-en">{tier.minTermMonths}-month minimum term, no setup fee</span>
                <span class="i18n-no" lang="nb">{tier.minTermMonths} måneders bindingstid, ingen etableringsgebyr</span>
              </p>
            )}

            <ul class:list={["mt-5 space-y-1.5 text-sm", featured ? "text-white" : "text-slate-700"]}>
              {tier.included.map((inc) => (
                <li>
                  {langs.map((lang) => (
                    <span class={lang === "no" ? "i18n-no" : "i18n-en"}>
                      {inc.label[lang]}: <strong>{formatValue(inc.value, lang)}</strong>
                    </span>
                  ))}
                  {inc.soon && <span class:list={["ml-1 text-xs", muted]}>(<Bi text={L.soon} />)</span>}
                </li>
              ))}
              {tier.overage && (
                <li>
                  {langs.map((lang) => (
                    <span class={lang === "no" ? "i18n-no" : "i18n-en"}>
                      {L.overage[lang]}: <strong>{overageText(tier, lang)}</strong>
                    </span>
                  ))}
                </li>
              )}
            </ul>

            <a
              href="/demo"
              class:list={[
                "mt-6 rounded-full px-4 py-2.5 text-center text-sm font-semibold shadow-sm transition-transform hover:scale-105",
                featured ? "bg-white text-violet-700" : "brand-gradient text-white shadow-violet-200",
              ]}
            >
              <Bi text={ctaText(tier)} />
            </a>

            <ul class="mt-6 space-y-2.5 text-sm">
              {tier.features.slice(0, 6).map((f) => (
                <li class:list={["flex gap-2", featured ? "text-indigo-50" : "text-slate-600"]}>
                  <span aria-hidden="true" class:list={featured ? "text-blue-200" : "text-violet-500"}>✓</span>
                  <span>
                    <Bi text={f} />
                    {f.soon && <span class:list={["ml-1 text-xs", muted]}>(<Bi text={L.soon} />)</span>}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </div>

  <!-- Comparison table -->
  <div class="mx-auto mt-12 max-w-5xl">
    <h3 class="font-display text-xl font-bold text-slate-900"><Bi text={L.compare} /></h3>
    <div class="mt-4 overflow-x-auto rounded-2xl border border-slate-200 bg-white" tabindex="0">
      <table class="w-full min-w-[560px] text-left text-sm">
        <caption class="sr-only">
          <Bi text={product.name} /> — <Bi text={L.compare} />
        </caption>
        <thead class="bg-slate-50 text-slate-900">
          <tr>
            <th scope="col" class="px-4 py-3 font-semibold"><Bi text={L.feature} /></th>
            {tiers.map((tier) => (
              <th scope="col" class="px-4 py-3 font-semibold"><Bi text={TIER_NAMES[tier.id]} /></th>
            ))}
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 text-slate-700">
          <tr>
            <th scope="row" class="px-4 py-3 font-medium"><Bi text={L.price} /></th>
            {tiers.map((tier) => (
              <td class="px-4 py-3 font-semibold text-slate-900">
                {langs.map((lang) => (
                  <span class={lang === "no" ? "i18n-no" : "i18n-en"}>
                    <span class="billing-monthly">{formatMonthly(tier, lang)}</span>
                    <span class="billing-yearly">{formatYearly(tier, lang)}</span>
                  </span>
                ))}
              </td>
            ))}
          </tr>
          {limitLabels.map((label) => (
            <tr>
              <th scope="row" class="px-4 py-3 font-medium"><Bi text={label} /></th>
              {tiers.map((tier) => {
                const inc = tier.included.find((i) => i.label.en === label.en);
                return (
                  <td class="px-4 py-3">
                    {inc ? (
                      <>
                        {langs.map((lang) => (
                          <span class={lang === "no" ? "i18n-no" : "i18n-en"}>{formatValue(inc.value, lang)}</span>
                        ))}
                        {inc.soon && <span class="ml-1 text-xs text-slate-400">(<Bi text={L.soon} />)</span>}
                      </>
                    ) : (
                      <>
                        <span aria-hidden="true">—</span>
                        <span class="sr-only"><Bi text={L.notIncluded} /></span>
                      </>
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
          {hasOverage && (
            <tr>
              <th scope="row" class="px-4 py-3 font-medium"><Bi text={L.overage} /></th>
              {tiers.map((tier) => (
                <td class="px-4 py-3">
                  {langs.map((lang) => (
                    <span class={lang === "no" ? "i18n-no" : "i18n-en"}>{overageText(tier, lang)}</span>
                  ))}
                </td>
              ))}
            </tr>
          )}
          {hasTerm && (
            <tr>
              <th scope="row" class="px-4 py-3 font-medium"><Bi text={L.term} /></th>
              {tiers.map((tier) => (
                <td class="px-4 py-3">
                  {tier.minTermMonths ? (
                    <>
                      {tier.minTermMonths} <Bi text={L.months} />
                    </>
                  ) : (
                    <Bi text={L.none} />
                  )}
                </td>
              ))}
            </tr>
          )}
          {featureRows.map((row) => (
            <tr>
              <th scope="row" class="px-4 py-3 font-medium"><Bi text={row} /></th>
              {tiers.map((tier) => {
                const f = tier.features.find((x) => x.en === row.en);
                return (
                  <td class="px-4 py-3">
                    {f ? (
                      <>
                        <span class="text-violet-600" aria-hidden="true">✓</span>
                        <span class="sr-only"><Bi text={L.included} /></span>
                        {f.soon && <span class="ml-1 text-xs text-slate-400">(<Bi text={L.soon} />)</span>}
                      </>
                    ) : (
                      <>
                        <span aria-hidden="true">—</span>
                        <span class="sr-only"><Bi text={L.notIncluded} /></span>
                      </>
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
        <tfoot class="bg-slate-50 text-xs text-slate-500">
          <tr>
            <th scope="row" class="px-4 py-2 font-medium"><Bi text={L.priceVat} /></th>
            {tiers.map((tier) => (
              <td class="px-4 py-2">
                {tier.priceNokMonthly === null
                  ? "—"
                  : langs.map((lang) => (
                      <span class={lang === "no" ? "i18n-no" : "i18n-en"}>
                        {tier.priceFrom ? (lang === "no" ? "fra " : "from ") : ""}
                        {formatNok(withVat(tier.priceNokMonthly as number), lang)}
                        {lang === "no" ? "/mnd" : "/month"}
                      </span>
                    ))}
              </td>
            ))}
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <PricingChart product={product} />

  <!-- FAQ -->
  <div class="mx-auto mt-12 max-w-3xl">
    <h3 class="font-display text-xl font-bold text-slate-900"><Bi text={L.faq} /></h3>
    <div class="mt-4 space-y-3">
      {
        product.faq.map((item) => (
          <details class="group rounded-2xl border border-slate-200 bg-white p-5">
            <summary class="cursor-pointer list-none font-semibold text-slate-900">
              <Bi text={item.q} />
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">
              <Bi text={item.a} />
            </p>
          </details>
        ))
      }
    </div>
  </div>
  <p class="mt-8 text-center text-xs text-slate-500">
    <span class="i18n-en">Prices are for businesses and exclude {PRICING_META.vatRate * 100}% MVA.</span>
    <span class="i18n-no" lang="nb">Prisene gjelder bedrifter og er oppgitt eks. {PRICING_META.vatRate * 100} % mva.</span>
  </p>
</section>
