---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";

// Not linked from the header nav (see Header.astro), same as the other
// three live-preview demo pages -- reachable via agents.astro's "Talk to
// it now" card.
//
// Unlike Voice Receptionist/Booking Assistant/Support Triage, this agent
// is a business's OWN back-office tool (analyzing THEIR reviews), not
// something a customer talks to -- there's no natural "have a
// conversation with it" demo the way the other three have. Instead this
// page is "paste a review, see what the agent would do with it,"
// talking to a dedicated PUBLIC, unauthenticated, never-persisted route
// (POST /api/agents/reviews/demo, see agents_reviews.py's own docstring
// on it) rather than the real (login-required) /api/agents/reviews/*
// routes the dashboard uses -- a website visitor has no business account
// to authenticate as.
//
// "Customer Intent" and "Recommended Action" below are derived client-side
// (review-reputation.js's detectIntent/recommendedAction) from the fields
// the demo endpoint already returns (sentiment, priority,
// requires_human_review, positive/negative points) -- the real agent
// (review_service.py) doesn't classify intent or return a next-action
// recommendation today, and adding that server-side is a bigger change
// than this page's own redesign calls for. Both are simple, honest
// mappings over real returned data, never fabricated content.
---

<Layout
  title="Try Our Review & Reputation Agent"
  description="An early preview of Mielikkix's AI Review & Reputation agent -- paste a review and see it analyzed, prioritized, and answered."
  path="/demo/review-reputation"
>
  <div class="mx-auto max-w-[1440px] px-6 pt-8">
    <a href="/agents" class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition-colors hover:text-violet-600">
      &larr; Back to AI Agents
    </a>
  </div>
  <PageHero
    line1="Meet Mielikkix's"
    line2="Review & Reputation Agent"
    subheading="Turn customer reviews into stronger relationships and a better reputation."
  />

  <section class="mx-auto max-w-2xl px-6 py-16">
    <p class="mx-auto -mt-6 mb-10 max-w-xl text-center text-sm leading-relaxed text-slate-500">
      Paste a customer review below and let your AI reputation assistant analyze the feedback, detect sentiment,
      identify the key issue, and draft a professional response in seconds.
    </p>

    <div class="rounded-3xl border border-slate-100 bg-white p-6 shadow-sm">
      <label for="reviewInput" class="text-sm font-semibold text-slate-700">Customer review</label>
      <textarea
        id="reviewInput"
        rows={4}
        placeholder="Paste a real or sample review here…"
        class="mt-2 w-full rounded-2xl border border-slate-200 p-3.5 text-sm outline-none focus:border-violet-400"
      ></textarea>
      <p id="reviewError" class="mt-1.5 hidden text-xs font-medium text-red-600">Please paste a review to analyze.</p>

      <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-slate-400">Try an example</p>
      <div class="mt-2 flex flex-wrap gap-1.5">
        {[
          "The food was excellent and the staff were very friendly, but we waited almost an hour for our order.",
          "It was fine, nothing special…",
          "Absolutely fantastic — the service was outstanding!",
          "I was overcharged and when I contacted the staff, nobody helped me.",
        ].map((example) => (
          <button
            type="button"
            class="example-btn rounded-full border border-slate-200 px-3 py-1 text-xs text-slate-500 hover:border-violet-400 hover:text-violet-600"
            data-text={example}
            title={example}
          >
            "{example.length > 36 ? example.slice(0, 36) + "…" : example}"
          </button>
        ))}
      </div>

      <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-5">
        <div class="flex items-center gap-2 text-xs text-slate-500">
          <span class="font-medium text-slate-600">Response tone:</span>
          <span class="rounded-full bg-slate-100 px-2.5 py-1 font-medium text-slate-600">Professional</span>
        </div>
        <button
          id="analyzeBtn"
          type="button"
          class="brand-gradient rounded-full px-5 py-2.5 text-sm font-semibold text-white transition-opacity disabled:cursor-not-allowed disabled:opacity-60"
        >
          Analyze Review &amp; Draft Response
        </button>
      </div>
      <p id="analyzeStatus" class="mt-3 hidden text-right text-xs font-medium text-violet-600"></p>
    </div>

    <div id="resultWrap" class="mt-6 hidden"></div>

    <div class="brand-gradient relative mt-10 overflow-hidden rounded-3xl px-8 py-10 text-center shadow-xl shadow-violet-200">
      <h2 class="font-display text-2xl font-bold text-white">Ready to manage your reputation with AI?</h2>
      <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-indigo-50">
        Connect your business to monitor reviews, understand customer sentiment, draft personalized responses, and
        build a stronger reputation over time.
      </p>
      <a
        href="/demo"
        class="mt-6 inline-block rounded-full bg-white px-7 py-3 text-sm font-semibold text-violet-700 shadow-sm transition-transform hover:scale-105"
      >
        Get Started
      </a>
    </div>
    <p class="mt-4 text-center text-xs text-slate-400">Demo only -- responses are never published automatically.</p>
  </section>

  <script src="/review-reputation.js" data-api-url={import.meta.env.PUBLIC_API_URL} defer></script>
</Layout>
