---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import en from "../assets/i18n/en/demo.json";
---

<Layout
  title={en.SEO.TITLE}
  description={en.SEO.DESCRIPTION}
  path="/demo"
  page="demo"
  titleKey="SEO.TITLE"
  descriptionKey="SEO.DESCRIPTION"
>
  <div class="mx-auto max-w-[1440px] px-6 pt-8">
    <a href="/agents" class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition-colors hover:text-violet-600" data-i18n="BACK_LINK">
      &larr; {en.BACK_LINK}
    </a>
  </div>
  <PageHero
    line1={en.PAGE_HERO.LINE1}
    line2={en.PAGE_HERO.LINE2}
    subheading={en.PAGE_HERO.SUBHEADING}
    line1Key="PAGE_HERO.LINE1"
    line2Key="PAGE_HERO.LINE2"
    subheadingKey="PAGE_HERO.SUBHEADING"
  />

  <section class="mx-auto max-w-2xl px-6 py-16">
    <ul class="mb-10 grid gap-3 sm:grid-cols-3">
      {
        en.REASSURANCES.map((r, i) => (
          <li class="rounded-xl border border-slate-100 bg-white p-4 text-center text-xs font-medium text-slate-500 shadow-sm" data-i18n={`REASSURANCES.${i}`}>
            {r}
          </li>
        ))
      }
    </ul>

    <form id="demo-form" class="space-y-5 rounded-3xl border border-slate-100 bg-white p-8 shadow-sm">
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="name" class="text-sm font-medium text-slate-700" data-i18n="FORM.NAME_LABEL">{en.FORM.NAME_LABEL}</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="mt-1.5 w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-indigo-100"
          />
        </div>
        <div>
          <label for="business" class="text-sm font-medium text-slate-700" data-i18n="FORM.BUSINESS_LABEL">{en.FORM.BUSINESS_LABEL}</label>
          <input
            type="text"
            id="business"
            name="business"
            required
            class="mt-1.5 w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-indigo-100"
          />
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="email" class="text-sm font-medium text-slate-700" data-i18n="FORM.EMAIL_LABEL">{en.FORM.EMAIL_LABEL}</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="mt-1.5 w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-indigo-100"
          />
        </div>
        <div>
          <label for="phone" class="text-sm font-medium text-slate-700" data-i18n="FORM.PHONE_LABEL">{en.FORM.PHONE_LABEL}</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            class="mt-1.5 w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-indigo-100"
          />
        </div>
      </div>

      <div>
        <label for="website" class="text-sm font-medium text-slate-700" data-i18n="FORM.WEBSITE_LABEL">{en.FORM.WEBSITE_LABEL}</label>
        <input
          type="url"
          id="website"
          name="website"
          placeholder="https://"
          class="mt-1.5 w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-indigo-100"
        />
      </div>

      <div>
        <label for="message" class="text-sm font-medium text-slate-700" data-i18n="FORM.MESSAGE_LABEL">{en.FORM.MESSAGE_LABEL}</label>
        <textarea
          id="message"
          name="message"
          rows="3"
          class="mt-1.5 w-full rounded-xl border border-slate-300 px-4 py-2.5 text-sm focus:border-violet-500 focus:outline-none focus:ring-2 focus:ring-indigo-100"
        ></textarea>
      </div>

      <button
        type="submit"
        class="brand-gradient w-full rounded-full px-6 py-3.5 text-sm font-semibold text-white shadow-sm shadow-violet-200 transition-transform hover:scale-[1.02]"
        data-i18n="FORM.SUBMIT"
      >
        {en.FORM.SUBMIT}
      </button>

    </form>

    <p id="demo-form-status" class="hidden mt-6 text-center text-sm font-medium text-emerald-600" role="status" data-i18n="STATUS.SUCCESS">{en.STATUS.SUCCESS}</p>
    <p id="demo-form-error" class="hidden mt-6 text-center text-sm font-medium text-red-600" role="alert" data-i18n="STATUS.ERROR">{en.STATUS.ERROR}</p>
  </section>

  <script
    src="/demo-form.js"
    data-api-url={import.meta.env.PUBLIC_API_URL}
    data-business-id={import.meta.env.PUBLIC_MIELIKKIX_BUSINESS_ID}
    defer
  ></script>
</Layout>
