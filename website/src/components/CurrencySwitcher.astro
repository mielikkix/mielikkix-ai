---
// Dropdown (native <details>/<summary>, no framework/JS needed for the open/close mechanic
// itself): the summary shows only the active currency, click it to reveal the others. Adding a
// currency to the registry in config/currency.ts (plus an entry in assets/currencies.json) is
// enough to add it here too — no markup changes. Prices are invoiced in NOK; EUR/USD are
// display-only conversions (see currencyStore.ts), which the footnote below says.
import Bi from "./pricing/Bi.astro";
import { SUPPORTED_CURRENCIES, DEFAULT_CURRENCY } from "../config/currency";

const initial = SUPPORTED_CURRENCIES.find((c) => c.code === DEFAULT_CURRENCY) ?? SUPPORTED_CURRENCIES[0];
---

<details class="currency-dropdown group relative inline-block">
  <summary
    class="flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-slate-200 bg-white/70 px-3 py-1.5 text-xs font-semibold text-slate-700 transition-colors hover:border-slate-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-500 [&::-webkit-details-marker]:hidden"
    role="button"
    aria-label="Currency"
  >
    <img class="currency-active-flag h-3 w-4 shrink-0 rounded-[2px] object-cover" src={initial.flag} alt="" />
    <span class="currency-active-code">{initial.code}</span>
    <svg class="h-3 w-3 text-slate-400 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.19l3.71-3.96a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
    </svg>
  </summary>

  <ul class="absolute right-0 z-50 mt-2 w-48 overflow-hidden rounded-xl border border-slate-200 bg-white py-1 shadow-lg">
    {
      SUPPORTED_CURRENCIES.map((currency) => (
        <li>
          <button
            type="button"
            class="currency-option flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-slate-700 hover:bg-slate-50"
            data-currency={currency.code}
            aria-label={currency.name}
          >
            <img class="h-3 w-4 shrink-0 rounded-[2px] object-cover" src={currency.flag} alt="" />
            <span class="flex-1">{currency.name}</span>
            <span class:list={["currency-option-check text-violet-600", currency.code !== DEFAULT_CURRENCY && "invisible"]}>✓</span>
          </button>
        </li>
      ))
    }
    <li class="mt-1 border-t border-slate-100 px-3 pb-1 pt-2 text-[11px] leading-snug text-slate-500">
      <Bi text={{ en: "Invoiced in NOK. EUR and USD are approximate.", no: "Faktureres i NOK. EUR og USD er omtrentlige." }} />
    </li>
  </ul>
</details>

<script>
  import { setCurrency, subscribe } from "../stores/currencyStore";
  import { SUPPORTED_CURRENCIES } from "../config/currency";
  import type { CurrencyCode } from "../config/currency";

  function closeAllDropdowns(except?: HTMLDetailsElement): void {
    document.querySelectorAll<HTMLDetailsElement>(".currency-dropdown").forEach((d) => {
      if (d !== except) d.removeAttribute("open");
    });
  }

  function applyActiveState(currency: CurrencyCode): void {
    const def = SUPPORTED_CURRENCIES.find((c) => c.code === currency);
    if (!def) return;
    document.querySelectorAll<HTMLDetailsElement>(".currency-dropdown").forEach((dropdown) => {
      const flagEl = dropdown.querySelector<HTMLImageElement>(".currency-active-flag");
      const codeEl = dropdown.querySelector(".currency-active-code");
      if (flagEl) flagEl.src = def.flag;
      if (codeEl) codeEl.textContent = def.code;
      dropdown.querySelectorAll<HTMLButtonElement>(".currency-option").forEach((btn) => {
        const check = btn.querySelector(".currency-option-check");
        check?.classList.toggle("invisible", btn.dataset.currency !== currency);
      });
    });
  }

  document.querySelectorAll<HTMLButtonElement>(".currency-option").forEach((btn) => {
    btn.addEventListener("click", () => {
      const currency = btn.dataset.currency as CurrencyCode | undefined;
      if (!currency) return;
      setCurrency(currency);
      closeAllDropdowns();
    });
  });

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest(".currency-dropdown")) closeAllDropdowns();
  });

  // subscribe() fires immediately with whatever state currencyStore currently holds, and
  // again once the Layout bootstrap's init() reads the real stored currency — so the
  // dropdown always ends up correct regardless of script execution order.
  subscribe((state) => applyActiveState(state.currency));
</script>
