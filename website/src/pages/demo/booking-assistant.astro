---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";

// Not linked from the header nav (see Header.astro), same as
// /demo/voice-receptionist -- reachable only via direct link for now.
// Talks to the real Phase 1-3 routes in app/api/agents_booking.py: real
// Google Calendar availability, real Groq-parsed free text, real event
// creation on the one connected test calendar (see that file's module
// docstring, and apps/agents/booking-assistant/CLAUDE.md for the full
// phased plan). NOT a per-tenant OAuth-connected calendar yet -- that's
// Phase 5 -- every booking made here lands on the same single test
// calendar, so this is a proof this agent works end to end, not a
// production booking page for a real business yet.
---

<Layout
  title="Try Our Booking Assistant"
  description="An early preview of Mielikkix's AI Booking Assistant -- describe what you want to book, pick a time, and get a real calendar invite."
  path="/demo/booking-assistant"
>
  <PageHero
    line1="Meet Mielikkix's"
    line2="Booking Assistant"
    subheading="An early preview -- describe what you'd like to book, in your own words."
  />

  <section class="mx-auto max-w-lg px-6 py-16">
    <div class="rounded-3xl border border-slate-100 bg-white p-7 shadow-sm">
      <!-- Step 1: describe the request -->
      <div id="step-describe">
        <label for="requestInput" class="mb-2 block text-sm font-semibold text-slate-800">
          What would you like to book?
        </label>
        <textarea
          id="requestInput"
          rows="3"
          placeholder="e.g. a 30 minute consultation next Tuesday afternoon"
          class="w-full resize-none rounded-2xl border border-slate-200 p-3.5 text-sm text-slate-800 outline-none focus:border-violet-400"
        ></textarea>
        <button
          id="findTimesBtn"
          class="brand-gradient mt-4 w-full rounded-full py-3 text-sm font-semibold text-white transition-transform hover:scale-[1.01] disabled:cursor-not-allowed disabled:opacity-60"
        >
          Find times
        </button>
        <p id="describeError" class="mt-3 hidden text-sm font-medium text-red-600"></p>
      </div>

      <!-- Step 2: pick a slot -->
      <div id="step-slots" class="hidden">
        <p id="slotsIntro" class="mb-3 text-sm font-semibold text-slate-800"></p>
        <div id="slotsList" class="flex flex-col gap-2"></div>
        <button id="backToDescribeBtn" class="mt-4 text-sm font-semibold text-violet-600">
          &larr; Describe something else
        </button>
      </div>

      <!-- Step 3: confirm details -->
      <div id="step-details" class="hidden">
        <p class="mb-3 text-sm font-semibold text-slate-800">
          Booking <span id="chosenSlotLabel" class="text-violet-600"></span>
        </p>
        <div class="flex flex-col gap-3">
          <input
            id="nameInput"
            type="text"
            placeholder="Your name"
            class="rounded-2xl border border-slate-200 p-3 text-sm outline-none focus:border-violet-400"
          />
          <input
            id="emailInput"
            type="email"
            placeholder="Your email"
            class="rounded-2xl border border-slate-200 p-3 text-sm outline-none focus:border-violet-400"
          />
        </div>
        <button
          id="confirmBtn"
          class="brand-gradient mt-4 w-full rounded-full py-3 text-sm font-semibold text-white transition-transform hover:scale-[1.01] disabled:cursor-not-allowed disabled:opacity-60"
        >
          Confirm booking
        </button>
        <p id="detailsError" class="mt-3 hidden text-sm font-medium text-red-600"></p>
        <button id="backToSlotsBtn" class="mt-3 text-sm font-semibold text-violet-600">
          &larr; Pick a different time
        </button>
      </div>

      <!-- Step 4: done -->
      <div id="step-done" class="hidden text-center">
        <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-emerald-50">
          <svg class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
        </div>
        <p class="mb-1 text-sm font-semibold text-slate-800">You're booked!</p>
        <p id="doneDetail" class="mb-5 text-sm text-slate-500"></p>
        <button
          id="bookAnotherBtn"
          class="rounded-full border border-slate-200 px-6 py-2.5 text-sm font-semibold text-slate-700"
        >
          Book something else
        </button>
      </div>
    </div>

    <p class="mt-6 rounded-2xl border border-slate-100 bg-slate-50 p-4 text-left text-xs leading-relaxed text-slate-500">
      Real calendar availability and a real Google Calendar invite -- but every booking made here
      lands on our one shared test calendar, not a real business's own calendar (see our
      <a href="/features" class="underline">features page</a> for how the real per-business product
      works). A confirmed booking really does create a calendar event and emails you an invite.
    </p>
  </section>

  <script src="/booking-assistant.js" data-api-url={import.meta.env.PUBLIC_API_URL} defer></script>
</Layout>
