---
import Layout from "../layouts/Layout.astro";
import FeatureBentoCard from "../components/FeatureBentoCard.astro";
import CTASection from "../components/CTASection.astro";
import PageHero from "../components/PageHero.astro";
import chatVideo from "../assets/chatbot v1.mp4";
import en from "../assets/i18n/en/features.json";

const f = en.FEATURES;
const valueProps = en.VALUE_PROPS;
const whyChoose = en.WHY_CHOOSE.ITEMS;
---

<Layout
  title={en.SEO.TITLE}
  description={en.SEO.DESCRIPTION}
  path="/features"
  page="features"
  titleKey="SEO.TITLE"
  descriptionKey="SEO.DESCRIPTION"
>
  <PageHero
    line1={en.PAGE_HERO.LINE1}
    line2={en.PAGE_HERO.LINE2}
    subheading={en.PAGE_HERO.SUBHEADING}
    line1Key="PAGE_HERO.LINE1"
    line2Key="PAGE_HERO.LINE2"
    subheadingKey="PAGE_HERO.SUBHEADING"
  >
    <div slot="extra" class="relative mx-auto mt-6 max-w-3xl text-center">
      <p class="text-lg text-indigo-50" data-i18n="PAGE_HERO.EXTRA_INTRO">
        {en.PAGE_HERO.EXTRA_INTRO}
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        {
          valueProps.map((v, i) => (
            <span
              class="rounded-full border border-white/30 bg-white/15 px-4 py-2 text-sm font-semibold text-white backdrop-blur"
              data-i18n={`VALUE_PROPS.${i}`}
            >
              {v}
            </span>
          ))
        }
      </div>
    </div>
  </PageHero>

  <!-- This page only covers the Chat Widget (see the retitled hero above)
       -- the Force Crew agents are a separate product line with their own
       page, and a visitor scanning this grid for "AI agents" content
       should be redirected there immediately, not partway down the page. -->
  <section class="mx-auto max-w-[1440px] px-6 pt-10">
    <div class="brand-gradient relative overflow-hidden rounded-2xl px-6 py-5 shadow-xl shadow-violet-200">
      <!-- Glossy highlight: a soft white-to-transparent sheen across the top
           half, the same "polished surface" trick used on glossy buttons/
           banners -- purely decorative, sits above the gradient, below the text. -->
      <div class="pointer-events-none absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-white/30 to-transparent"></div>
      <div class="relative flex flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left">
        <p class="text-sm font-medium text-white" data-i18n="AGENTS_CALLOUT.TEXT">{en.AGENTS_CALLOUT.TEXT}</p>
        <a
          href="/agents"
          data-i18n="AGENTS_CALLOUT.CTA"
          class="shrink-0 rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-violet-700 shadow-sm transition-transform hover:scale-105"
        >
          {en.AGENTS_CALLOUT.CTA} &rarr;
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1440px] px-6 py-16">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-6">
      <!-- AI Chat Assistant (flagship, full width) -->
      <FeatureBentoCard span="lg:col-span-6">
        <div class="grid gap-8 lg:grid-cols-2">
          <div>
            <div class="flex items-center gap-2.5">
              <span class="h-2.5 w-2.5 rounded-full bg-violet-500" />
              <h3 class="font-display text-2xl font-bold text-slate-900" data-i18n="FEATURES.AI_CHAT_ASSISTANT.TITLE">
                {f.AI_CHAT_ASSISTANT.TITLE}
              </h3>
            </div>
            <p class="mt-3 max-w-md text-lg text-slate-500" data-i18n="FEATURES.AI_CHAT_ASSISTANT.DESCRIPTION">
              {f.AI_CHAT_ASSISTANT.DESCRIPTION}
            </p>
            <ul class="mt-6 grid grid-cols-1 gap-x-6 gap-y-2 text-base text-slate-600 sm:grid-cols-2">
              {
                f.AI_CHAT_ASSISTANT.BULLETS.map((b, i) => (
                  <li>
                    <span class="text-emerald-500">✓</span> <span data-i18n={`FEATURES.AI_CHAT_ASSISTANT.BULLETS.${i}`}>{b}</span>
                  </li>
                ))
              }
            </ul>
            <div class="mt-6 grid grid-cols-3 gap-3">
              {
                f.AI_CHAT_ASSISTANT.STATS.map((stat, i) => (
                  <div class="rounded-xl bg-slate-100 p-3 text-center shadow-sm">
                    <p class="font-display text-lg font-bold text-slate-900" data-i18n={`FEATURES.AI_CHAT_ASSISTANT.STATS.${i}.VALUE`}>
                      {stat.VALUE}
                    </p>
                    <p class="text-xs text-slate-400" data-i18n={`FEATURES.AI_CHAT_ASSISTANT.STATS.${i}.LABEL`}>
                      {stat.LABEL}
                    </p>
                  </div>
                ))
              }
            </div>
            <div class="mt-6 rounded-xl border border-violet-200 bg-violet-50 px-4 py-3 text-sm text-violet-700" data-i18n="FEATURES.AI_CHAT_ASSISTANT.CALLOUT">
              {f.AI_CHAT_ASSISTANT.CALLOUT}
            </div>
          </div>
          <div class="flex w-full justify-center self-start">
            <video
              id="chat-demo-video"
              class="aspect-[282/446] w-full max-w-[280px] rounded-2xl object-cover shadow-lg"
              src={chatVideo}
              autoplay
              loop
              muted
              playsinline
              aria-label={f.AI_CHAT_ASSISTANT.VIDEO_ALT}
              data-i18n-attr="aria-label:FEATURES.AI_CHAT_ASSISTANT.VIDEO_ALT"
            />
          </div>
        </div>
        <script src="/reduced-motion-video.js" data-video-id="chat-demo-video" defer></script>
      </FeatureBentoCard>

      <!-- AI Knowledge Base -->
      <FeatureBentoCard
        title={f.KNOWLEDGE_BASE.TITLE}
        description={f.KNOWLEDGE_BASE.DESCRIPTION}
        titleKey="FEATURES.KNOWLEDGE_BASE.TITLE"
        descriptionKey="FEATURES.KNOWLEDGE_BASE.DESCRIPTION"
        dot="bg-blue-500"
        span="lg:col-span-3"
      >
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-base text-slate-600">
          {
            f.KNOWLEDGE_BASE.BULLETS.map((b, i) => (
              <li>
                <span class="text-emerald-500">✓</span> <span data-i18n={`FEATURES.KNOWLEDGE_BASE.BULLETS.${i}`}>{b}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 rounded-2xl border border-slate-300 bg-slate-100 p-4 text-center">
          <div class="flex flex-wrap justify-center gap-2">
            <span class="rounded-full bg-violet-50 px-3 py-1.5 text-sm font-medium text-violet-600" data-i18n="FEATURES.KNOWLEDGE_BASE.TAG_FAQS">
              {f.KNOWLEDGE_BASE.TAG_FAQS}
            </span>
            <span class="rounded-full bg-blue-50 px-3 py-1.5 text-sm font-medium text-blue-600" data-i18n="FEATURES.KNOWLEDGE_BASE.TAG_DOCUMENTS">
              {f.KNOWLEDGE_BASE.TAG_DOCUMENTS}
            </span>
            <span class="rounded-full bg-indigo-50 px-3 py-1.5 text-sm font-medium text-indigo-600" data-i18n="FEATURES.KNOWLEDGE_BASE.TAG_CATALOG">
              {f.KNOWLEDGE_BASE.TAG_CATALOG}
            </span>
          </div>
          <div class="mx-auto mt-3 h-6 w-px bg-slate-200"></div>
          <div class="mx-auto mt-1 max-w-[85%] rounded-xl rounded-tl-sm bg-slate-50 px-4 py-3 text-base text-slate-600">
            <span data-i18n="FEATURES.KNOWLEDGE_BASE.GROUNDED_ANSWER">{f.KNOWLEDGE_BASE.GROUNDED_ANSWER}</span> <span class="text-emerald-500">✓</span>
          </div>
        </div>
      </FeatureBentoCard>

      <!-- Lead Generation -->
      <FeatureBentoCard
        title={f.LEAD_GENERATION.TITLE}
        description={f.LEAD_GENERATION.DESCRIPTION}
        titleKey="FEATURES.LEAD_GENERATION.TITLE"
        descriptionKey="FEATURES.LEAD_GENERATION.DESCRIPTION"
        dot="bg-emerald-500"
        span="lg:col-span-3"
      >
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-base text-slate-600">
          {
            f.LEAD_GENERATION.BULLETS.map((b, i) => (
              <li>
                <span class="text-emerald-500">✓</span> <span data-i18n={`FEATURES.LEAD_GENERATION.BULLETS.${i}`}>{b}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 rounded-2xl border border-slate-300 bg-slate-100 p-4">
          <div class="mb-3 flex items-center justify-between">
            <span class="text-sm font-semibold text-slate-500" data-i18n="FEATURES.LEAD_GENERATION.CONTACT_DETAILS">
              {f.LEAD_GENERATION.CONTACT_DETAILS}
            </span>
            <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-600" data-i18n="FEATURES.LEAD_GENERATION.NEW_LEAD">
              {f.LEAD_GENERATION.NEW_LEAD}
            </span>
          </div>
          <div class="mb-2 h-3 w-full rounded-full bg-slate-200"></div>
          <div class="mb-3 h-3 w-3/4 rounded-full bg-slate-200"></div>
          <div class="brand-gradient rounded-full py-2 text-center text-sm font-semibold text-white" data-i18n="FEATURES.LEAD_GENERATION.CONTACT_ME">
            {f.LEAD_GENERATION.CONTACT_ME}
          </div>
        </div>
      </FeatureBentoCard>

      <!-- Business Analytics -->
      <FeatureBentoCard
        title={f.BUSINESS_ANALYTICS.TITLE}
        description={f.BUSINESS_ANALYTICS.DESCRIPTION}
        titleKey="FEATURES.BUSINESS_ANALYTICS.TITLE"
        descriptionKey="FEATURES.BUSINESS_ANALYTICS.DESCRIPTION"
        dot="bg-amber-500"
        span="lg:col-span-4"
      >
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-base text-slate-600">
          {
            f.BUSINESS_ANALYTICS.BULLETS.map((b, i) => (
              <li>
                <span class="text-emerald-500">✓</span> <span data-i18n={`FEATURES.BUSINESS_ANALYTICS.BULLETS.${i}`}>{b}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 grid grid-cols-3 gap-3">
          {
            f.BUSINESS_ANALYTICS.STATS.map((stat, i) => (
              <div class="rounded-xl border border-slate-300 bg-slate-100 p-4 text-center">
                <p class="font-display text-2xl font-bold text-slate-900" data-i18n={`FEATURES.BUSINESS_ANALYTICS.STATS.${i}.VALUE`}>
                  {stat.VALUE}
                </p>
                <p class="text-xs text-slate-400" data-i18n={`FEATURES.BUSINESS_ANALYTICS.STATS.${i}.LABEL`}>
                  {stat.LABEL}
                </p>
              </div>
            ))
          }
        </div>
      </FeatureBentoCard>

      <!-- Instant Notifications -->
      <FeatureBentoCard
        title={f.NOTIFICATIONS.TITLE}
        description={f.NOTIFICATIONS.DESCRIPTION}
        titleKey="FEATURES.NOTIFICATIONS.TITLE"
        descriptionKey="FEATURES.NOTIFICATIONS.DESCRIPTION"
        dot="bg-indigo-500"
        span="lg:col-span-2"
      >
        <ul class="mt-4 space-y-2 text-base text-slate-600">
          {
            f.NOTIFICATIONS.ITEMS.map((item, i) => (
              <li class:list={[!item.AVAILABLE && "text-slate-400"]}>
                {item.AVAILABLE && <span class="text-emerald-500">✓ </span>}
                <span data-i18n={`FEATURES.NOTIFICATIONS.ITEMS.${i}.TEXT`}>{item.TEXT}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 rounded-2xl border border-slate-300 bg-slate-100 p-4">
          <div class="flex items-center gap-3">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-blue-100 text-xs font-bold text-blue-600" data-i18n="FEATURES.NOTIFICATIONS.MOCK_NEW_BADGE">
              {f.NOTIFICATIONS.MOCK_NEW_BADGE}
            </span>
            <div class="text-left">
              <p class="text-sm font-semibold text-slate-700" data-i18n="FEATURES.NOTIFICATIONS.MOCK_TITLE">
                {f.NOTIFICATIONS.MOCK_TITLE}
              </p>
              <p class="text-xs text-slate-400" data-i18n="FEATURES.NOTIFICATIONS.MOCK_SUBTEXT">
                {f.NOTIFICATIONS.MOCK_SUBTEXT}
              </p>
            </div>
          </div>
        </div>
      </FeatureBentoCard>

      <!-- Multi-Language -->
      <FeatureBentoCard
        title={f.MULTI_LANGUAGE.TITLE}
        description={f.MULTI_LANGUAGE.DESCRIPTION}
        titleKey="FEATURES.MULTI_LANGUAGE.TITLE"
        descriptionKey="FEATURES.MULTI_LANGUAGE.DESCRIPTION"
        dot="bg-blue-500"
        span="lg:col-span-2"
      >
        <ul class="mt-4 space-y-2 text-base text-slate-600">
          {
            f.MULTI_LANGUAGE.ITEMS.map((item, i) => (
              <li class:list={[!item.AVAILABLE && "text-slate-400"]}>
                {item.AVAILABLE && <span class="text-emerald-500">✓ </span>}
                <span data-i18n={`FEATURES.MULTI_LANGUAGE.ITEMS.${i}.TEXT`}>{item.TEXT}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 flex flex-wrap gap-2 rounded-2xl border border-slate-300 bg-slate-100 p-4">
          {
            ["EN", "NO", "DE", "FR", "ES", "IT", "NL", "PL", "PT", "SV"].map((code) => (
              <span class="rounded-full bg-white px-3 py-1.5 text-sm font-semibold text-indigo-700 shadow-sm">{code}</span>
            ))
          }
        </div>
      </FeatureBentoCard>

      <!-- Multi-Currency -->
      <FeatureBentoCard
        title={f.MULTI_CURRENCY.TITLE}
        description={f.MULTI_CURRENCY.DESCRIPTION}
        titleKey="FEATURES.MULTI_CURRENCY.TITLE"
        descriptionKey="FEATURES.MULTI_CURRENCY.DESCRIPTION"
        dot="bg-emerald-500"
        span="lg:col-span-2"
      >
        <ul class="mt-4 space-y-2 text-base text-slate-600">
          {
            f.MULTI_CURRENCY.ITEMS.map((item, i) => (
              <li>
                <span class="text-emerald-500">✓</span> <span data-i18n={`FEATURES.MULTI_CURRENCY.ITEMS.${i}`}>{item}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 flex flex-wrap gap-2 rounded-2xl border border-slate-300 bg-slate-100 p-4">
          <span class="rounded-full bg-white px-3 py-1.5 text-sm font-semibold text-indigo-700 shadow-sm">₹ INR</span>
          <span class="rounded-full bg-white px-3 py-1.5 text-sm font-semibold text-indigo-700 shadow-sm">$ USD</span>
          <span class="rounded-full bg-white px-3 py-1.5 text-sm font-semibold text-indigo-700 shadow-sm">€ EUR</span>
          <span class="rounded-full bg-white px-3 py-1.5 text-sm font-semibold text-indigo-700 shadow-sm">kr NOK</span>
        </div>
      </FeatureBentoCard>

      <!-- Widget Customization -->
      <FeatureBentoCard
        title={f.WIDGET_CUSTOMIZATION.TITLE}
        description={f.WIDGET_CUSTOMIZATION.DESCRIPTION}
        titleKey="FEATURES.WIDGET_CUSTOMIZATION.TITLE"
        descriptionKey="FEATURES.WIDGET_CUSTOMIZATION.DESCRIPTION"
        dot="bg-violet-500"
        span="lg:col-span-2"
      >
        <ul class="mt-4 space-y-2 text-base text-slate-600">
          {
            f.WIDGET_CUSTOMIZATION.ITEMS.map((item, i) => (
              <li class:list={[!item.AVAILABLE && "text-slate-400"]}>
                {item.AVAILABLE && <span class="text-emerald-500">✓ </span>}
                <span data-i18n={`FEATURES.WIDGET_CUSTOMIZATION.ITEMS.${i}.TEXT`}>{item.TEXT}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 rounded-2xl border border-slate-300 bg-slate-100 p-4 text-center">
          <div class="flex justify-center gap-2">
            <span class="h-6 w-6 rounded-full bg-violet-500 ring-2 ring-violet-200 ring-offset-2"></span>
            <span class="h-6 w-6 rounded-full bg-blue-500"></span>
            <span class="h-6 w-6 rounded-full bg-emerald-500"></span>
            <span class="h-6 w-6 rounded-full bg-amber-500"></span>
          </div>
          <div class="mx-auto mt-3 rounded-lg border border-slate-300 px-3 py-1.5 text-left text-sm text-slate-500">
            <span data-i18n="FEATURES.WIDGET_CUSTOMIZATION.BOT_NAME_LABEL">{f.WIDGET_CUSTOMIZATION.BOT_NAME_LABEL}</span>{" "}
            <span class="font-semibold text-slate-700" data-i18n="FEATURES.WIDGET_CUSTOMIZATION.BOT_NAME_VALUE">{f.WIDGET_CUSTOMIZATION.BOT_NAME_VALUE}</span>
          </div>
        </div>
      </FeatureBentoCard>

      <!-- Build Customer Trust -->
      <FeatureBentoCard
        title={f.CUSTOMER_TRUST.TITLE}
        description={f.CUSTOMER_TRUST.DESCRIPTION}
        titleKey="FEATURES.CUSTOMER_TRUST.TITLE"
        descriptionKey="FEATURES.CUSTOMER_TRUST.DESCRIPTION"
        dot="bg-amber-500"
        span="lg:col-span-3"
      >
        <ul class="mt-4 space-y-2 text-base text-slate-600">
          {
            f.CUSTOMER_TRUST.ITEMS.map((item, i) => (
              <li class:list={[!item.AVAILABLE && "text-slate-400"]}>
                {item.AVAILABLE && <span class="text-emerald-500">✓ </span>}
                <span data-i18n={`FEATURES.CUSTOMER_TRUST.ITEMS.${i}.TEXT`}>{item.TEXT}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 rounded-2xl border border-slate-300 bg-slate-100 px-6 py-4 text-center">
          <p class="font-display text-3xl font-bold text-slate-900">
            <span data-i18n="FEATURES.CUSTOMER_TRUST.RATING_VALUE">{f.CUSTOMER_TRUST.RATING_VALUE}</span><span class="text-lg text-slate-400" data-i18n="FEATURES.CUSTOMER_TRUST.RATING_MAX">{f.CUSTOMER_TRUST.RATING_MAX}</span>
          </p>
          <p class="text-xs text-slate-400" data-i18n="FEATURES.CUSTOMER_TRUST.REVIEWS_LABEL">{f.CUSTOMER_TRUST.REVIEWS_LABEL}</p>
        </div>
      </FeatureBentoCard>

      <!-- Security -->
      <FeatureBentoCard
        title={f.SECURITY.TITLE}
        description={f.SECURITY.DESCRIPTION}
        titleKey="FEATURES.SECURITY.TITLE"
        descriptionKey="FEATURES.SECURITY.DESCRIPTION"
        dot="bg-indigo-500"
        span="lg:col-span-3"
      >
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-base text-slate-600">
          {
            f.SECURITY.BULLETS.map((b, i) => (
              <li>
                <span class="text-emerald-500">✓</span> <span data-i18n={`FEATURES.SECURITY.BULLETS.${i}`}>{b}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 flex items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-slate-100 p-4 text-sm font-medium">
          <span class="rounded-lg bg-white px-3 py-1.5 text-slate-500 shadow-sm" data-i18n="FEATURES.SECURITY.BUSINESS_A">
            {f.SECURITY.BUSINESS_A}
          </span>
          <span class="text-slate-400">✕</span>
          <span class="rounded-lg bg-white px-3 py-1.5 text-slate-500 shadow-sm" data-i18n="FEATURES.SECURITY.BUSINESS_B">
            {f.SECURITY.BUSINESS_B}
          </span>
        </div>
      </FeatureBentoCard>

      <!-- Easy Installation (closing, full width) -->
      <FeatureBentoCard
        title={f.EASY_INSTALLATION.TITLE}
        description={f.EASY_INSTALLATION.DESCRIPTION}
        titleKey="FEATURES.EASY_INSTALLATION.TITLE"
        descriptionKey="FEATURES.EASY_INSTALLATION.DESCRIPTION"
        dot="bg-violet-500"
        span="lg:col-span-6"
      >
        <div class="mt-6 flex flex-col items-center gap-6 lg:flex-row lg:justify-between">
          <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-base text-slate-600">
            {
              f.EASY_INSTALLATION.BULLETS.map((b, i) => (
                <li>
                  <span class="text-emerald-500">✓</span> <span data-i18n={`FEATURES.EASY_INSTALLATION.BULLETS.${i}`}>{b}</span>
                </li>
              ))
            }
          </ul>
          <div class="w-full max-w-md rounded-xl border border-slate-300 bg-slate-100 p-4 shadow-sm">
            <div class="mb-3 flex gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
            </div>
            <div class="rounded-lg bg-slate-900 px-4 py-3 font-mono text-xs leading-relaxed text-blue-300 sm:text-sm">
              &lt;script src="https://cdn.mielikkix.ai/mielikkix.js"&gt;<br />&lt;/script&gt;
            </div>
          </div>
        </div>
      </FeatureBentoCard>
    </div>
  </section>

  <!-- Why Businesses Choose MielikkiX -->
  <section class="mx-auto max-w-[1440px] px-6 pb-20">
    <div class="rounded-3xl border border-slate-300 bg-white p-10 shadow-sm shadow-slate-200/60">
      <h3 class="font-display text-center text-3xl font-bold text-slate-900" data-i18n="WHY_CHOOSE.HEADING">
        {en.WHY_CHOOSE.HEADING}
      </h3>
      <ul class="mx-auto mt-8 grid max-w-4xl grid-cols-2 gap-x-8 gap-y-3 text-lg text-slate-600 sm:grid-cols-4">
        {
          whyChoose.map((item, i) => (
            <li class="flex items-start gap-2">
              <span class="text-emerald-500">✓</span>
              <span data-i18n={`WHY_CHOOSE.ITEMS.${i}`}>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTASection
    heading={en.CTA.HEADING}
    subheading={en.CTA.SUBHEADING}
    headingKey="CTA.HEADING"
    subheadingKey="CTA.SUBHEADING"
  />
</Layout>
