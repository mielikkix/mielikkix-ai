---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";

// Business direction (2026-08-30): Mielikkix is not productizing all 10
// originally-planned Force agents right now. The page communicates three
// tiers, in descending visual weight:
//   1. Core solutions -- AI Chatbot (the live product), Voice Receptionist
//      and Booking Assistant (working previews) -- the three things a
//      visitor can actually use/try today.
//   2. Additional built demos -- Support Triage, Review & Reputation --
//      real, working previews (see their own CLAUDE.md files) but not part
//      of the current core-product push.
//   3. Custom AI agent development -- the remaining agent concepts (social,
//      email, SEO, feedback, loyalty, quote/invoice, plus a few new
//      capability examples) presented as examples of what Mielikkix can
//      build to order, NOT as products in a pipeline -- deliberately no
//      "Coming Soon" language anywhere in this section (see the section's
//      own comment below for why).

const coreSolutions = [
  {
    name: "AI Chatbot",
    description:
      "24/7 AI-powered customer conversations that answer questions, capture leads, and help customers instantly.",
    status: "Core Solution",
    statusClass: "bg-indigo-50 text-indigo-700",
    cta: "Explore Chatbot",
    // The chatbot itself has no single dedicated demo route -- it's the
    // live product embedded sitewide -- so this points at the page that
    // actually explains what it does (knowledge base, lead capture,
    // analytics, notifications), same target the rest of the site already
    // uses for "learn more about the chatbot."
    href: "/features",
    icon: "M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155",
  },
  {
    name: "Voice Receptionist",
    description:
      "An AI receptionist that answers calls, handles customer questions, captures requests, and can assist with appointments.",
    status: "Live Demo",
    statusClass: "bg-emerald-50 text-emerald-700",
    cta: "Try Voice Receptionist",
    href: "/demo/voice-receptionist",
    icon: "M2.25 6.75c0 8.284 6.716 15 15 15h1.5a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z",
  },
  {
    name: "Booking Assistant",
    description:
      "An AI booking assistant that helps customers schedule appointments and manage booking-related conversations.",
    status: "Live Demo",
    statusClass: "bg-emerald-50 text-emerald-700",
    cta: "Try Booking Assistant",
    href: "/demo/booking-assistant",
    icon: "M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008Z",
  },
];

const additionalAgents = [
  {
    name: "Support Triage",
    description:
      "Sorts inbound support requests, identifies priority, drafts responses, and helps route issues to the right team.",
    href: "/demo/support-triage",
    icon: "M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z",
