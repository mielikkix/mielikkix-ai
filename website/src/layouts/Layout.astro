---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ConsentBanner from "../components/ConsentBanner.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
  /** Which page-JSON namespace (src/assets/i18n/<lang>/<page>.json) drives client-side translation on this page. Omit for pages with no translation JSON. */
  page?: "home" | "features" | "pricing" | "agent-pricing" | "agents" | "demo";
  /** Dot-path into that page's JSON for the translated <title> (e.g. "SEO.TITLE"). */
  titleKey?: string;
  /** Dot-path into that page's JSON for the translated meta description (e.g. "SEO.DESCRIPTION"). */
  descriptionKey?: string;
  /**
   * Extra schema.org nodes (e.g. a BlogPosting) for THIS page only, merged into
   * the same single JSON-LD @graph as the sitewide Organization/WebSite below --
   * never a second <script type="application/ld+json"> tag, and never a reason
   * to repeat Organization/WebSite's own properties. Reference them instead via
   * {"@id": "https://mielikkix.ai/#organization"} / "#website" (see how the
   * WebSite node below references Organization as its publisher).
   */
  structuredDataNodes?: Record<string, unknown>[];
  /**
   * Set false when `title` (and its titleKey translations) already contains the
   * brand, e.g. the homepage's "Mielikkix | ...", so it isn't doubled. Mirrored to
   * the client-side i18n title swap via body[data-title-suffix].
   */
  titleSuffix?: boolean;
}

const { title, description, path = "/", page, titleKey, descriptionKey, structuredDataNodes, titleSuffix = true } = Astro.props;
const fullTitle = titleSuffix ? `${title} · Mielikkix` : title;
const siteUrl = Astro.site ?? new URL("https://mielikkix.ai");

// Every route here builds to a directory + index.html (astro.config.mjs's default
// trailingSlash behavior), and the production host's Apache 301-redirects a
// slash-less request to the slash form (mod_dir's default DirectorySlash) -- so the
// canonical/OG URL must already BE the slash form to match the sitemap and the
// actual served URL exactly, rather than pointing at a URL that just redirects to it.
const normalizedPath = path.endsWith("/") ? path : `${path}/`;
const canonicalUrl = new URL(normalizedPath, siteUrl).toString();
const ogImage = new URL("/og-image.png", siteUrl).toString();

// Only renders once a real Plausible account/domain exists (see .env.example) --
// no PUBLIC_PLAUSIBLE_DOMAIN means no third-party script and no tracking request.
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;

// GA4 (PUBLIC_GA_MEASUREMENT_ID) is NOT rendered here: it's only injected
// client-side by ConsentBanner after the visitor opts in to analytics
// (GDPR/ekomloven -- see src/lib/consent.ts). mielikkix.com/.no are untouched.

// Organization + WebSite structured data (schema.org), identical on every page --
// this is the structured, machine-readable signal that the entity "Mielikkix" is
// officially represented by this domain (as opposed to relying on prose alone).
// Deliberately minimal, per 2026-09-19 SEO audit decisions:
//  - no legalName ("Mielikkix AS" registration is still in process -- see
//    src/pages/privacy.astro)
//  - no sameAs (no verified company social profiles exist yet)
//  - no SearchAction on WebSite (no on-site search feature exists)
//  - no address/telephone/VAT/aggregateRating (none of that is real data to publish)
// Stable @id values (site root + #organization / #website) let WebSite reference
// Organization as its publisher without duplicating data or creating two
// unlinked entities.
// email/address/knowsAbout/slogan are limited to what's already public on the
// site (post@mielikkix.no and Norway on /privacy, the footer tagline, the
// products on /agents) -- nothing here that isn't substantiated elsewhere.
// address is country-only on purpose: it says where Mielikkix is BASED, not
// where it serves (Norway and internationally, per the homepage) -- which is
// also why there's no areaServed: a Norway-only list would misstate that, and
// an arbitrary country list/"Worldwide" would be unsubstantiated. Full address
// waits for the completed company registration.
const siteRootUrl = new URL("/", siteUrl).toString();
// Dedicated structured-data logo: a square, ~17 KB 512x512 export of the same
// mark as favicon.png (which is ~960 KB and non-square). Keep width/height in
// sync with the actual file if it's ever regenerated.
const logoUrl = new URL("/mielikkix-logo.png", siteUrl).toString();
const organizationId = `${siteRootUrl}#organization`;
const websiteId = `${siteRootUrl}#website`;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "Mielikkix",
      url: siteRootUrl,
      logo: {
        "@type": "ImageObject",
        url: logoUrl,
        width: 512,
        height: 512,
      },
      description:
        "Mielikkix is a Norway-based AI automation company that helps small and growing businesses with AI chatbots, voice receptionists, booking assistants, customer support automation, SEO solutions and custom AI workflows. We serve businesses in Norway and internationally.",
      email: "post@mielikkix.no",
      address: { "@type": "PostalAddress", addressCountry: "NO" },
      knowsAbout: [
        "AI chatbots",
        "AI voice receptionists",
        "AI booking assistants",
        "AI customer support automation",
        "SEO auditing",
        "AI agent development",
        "business automation",
      ],
      slogan: "Never Miss a Customer",
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: "Mielikkix",
      url: siteRootUrl,
      publisher: { "@id": organizationId },
    },
    ...(structuredDataNodes ?? []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="wwBSRJoUkdycn0t-ycVvIjYco3FmxAyBV0A7lGaugMM" />

    <!--
      Runs before paint: if a returning visitor has a non-default language stored,
      hide <body> (see html.i18n-loading in global.css) until the client-side i18n
      bootstrap (at the end of <body>) applies it, avoiding an English flash.
      External file (not is:inline) so it isn't blocked by the script-src CSP.
    -->
    <script is:inline src="/i18n-guard.js"></script>

    <title data-i18n-doc-title={titleKey}>{fullTitle}</title>
    <meta name="description" content={description} data-i18n-meta-desc={descriptionKey} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mielikkix" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} data-i18n-meta-title={titleKey} />
    <meta property="og:description" content={description} data-i18n-meta-desc={descriptionKey} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} data-i18n-meta-title={titleKey} />
    <meta name="twitter:description" content={description} data-i18n-meta-desc={descriptionKey} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    {plausibleDomain && (
      <script is:inline data-domain={plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased" data-page={page} data-title-suffix={titleSuffix ? undefined : "off"}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <script>
      import { initI18n, getStoredLanguage, SUPPORTED_LANGUAGES } from "../lib/i18n/translationService";
      import { init as initCurrency } from "../stores/currencyStore";
      import { DEFAULT_CURRENCY } from "../config/currency";

      const mielikkixPage = document.body.dataset.page;
      void initI18n(mielikkixPage);

      // Currency follows the selected language as one combined switch (see SUPPORTED_LANGUAGES).
      const storedLang = getStoredLanguage();
      const currencyForLang = SUPPORTED_LANGUAGES.find((l) => l.code === storedLang)?.currency ?? DEFAULT_CURRENCY;
      void initCurrency(currencyForLang);
    </script>
    <!--
      The real tenant-facing product widget (app.mielikkix.ai/widget.js),
      dogfooded on mielikkix.ai's own site -- Mielikkix using its own AI
      Chatbot product on its own marketing site, the same embed snippet any
      tenant business copies from their dashboard's "Embed your chatbot"
      card (data-business is Mielikkix's own business_id, the same one that
      dashboard, FAQs, and the Overview stats all belong to). Previously
      this was /support-chat-widget.js (Support Triage) sitewide -- that
      demo now lives on its own dedicated page, /demo/support-triage.astro
      (with its own separate support-triage.js embed), the same pattern
      /demo/voice-receptionist and /demo/booking-assistant already use.
    -->
    <script is:inline src="/widget-common.js"></script>
    <script src="https://app.mielikkix.ai/widget.js" data-business="c7650cb2-6ea1-4cc2-846b-2f7cc4025267"></script>
  </body>
</html>
