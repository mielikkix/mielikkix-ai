---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";

// Not linked from the header nav (see Header.astro) -- reachable only via
// direct link for now. Real voice in (your mic, via the browser's own
// speech recognition) / real voice out (browser TTS), talking to the same
// conversation + RAG-grounding logic apps/api/app/api/agents_voice.py's
// real Twilio-facing route uses. NOT Twilio's voice or speech recognition,
// and NOT a real phone call -- see the on-page note below for why, and
// apps/agents/voice-receptionist/CLAUDE.md for the actual phased plan.
---

<Layout
  title="Talk to Our Voice Receptionist"
  description="An early preview of Mielikkix's AI Voice Receptionist -- talk to it live, right in your browser."
  path="/demo/voice-receptionist"
>
  <div class="mx-auto max-w-[1440px] px-6 pt-8">
    <a href="/agents" class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition-colors hover:text-violet-600">
      &larr; Back to AI Agents
    </a>
  </div>
  <PageHero
    line1="Meet Mielikkix's"
    line2="Voice Receptionist"
    subheading="An early preview -- talk to it right now, using your own microphone."
  />

  <section class="mx-auto max-w-lg px-6 py-16">
    <div class="rounded-3xl border border-slate-100 bg-white p-9 text-center shadow-sm">
      <p id="unsupported" class="mb-6 hidden text-sm font-medium text-red-600">
        This browser doesn't support live speech recognition. Please try a recent Chrome or Edge.
      </p>

      <button
        id="pillBtn"
        class="mx-auto mb-5 flex items-center gap-3 rounded-full border border-slate-200 bg-white py-2 pl-2 pr-5 shadow-sm transition-transform hover:scale-[1.02] disabled:cursor-not-allowed disabled:hover:scale-100"
      >
        <span class="relative block h-10 w-10 shrink-0">
          <span id="avatarRing" class="brand-gradient absolute inset-0 rounded-full opacity-20"></span>
          <img
            src="/images/mieli-avatar.png"
            alt="Mieli"
            class="relative h-10 w-10 rounded-full object-cover"
          />
        </span>
        <svg
          id="pillMic"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4 text-slate-700"
        >
          <path d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
        </svg>
        <span id="pillLabel" class="text-sm font-semibold text-slate-800">Speak now</span>
      </button>

      <div id="waveform" class="mb-3 hidden h-6 items-center justify-center gap-1">
        <span class="w-1 rounded-full bg-violet-500" style="height:6px"></span>
        <span class="w-1 rounded-full bg-violet-500" style="height:6px"></span>
        <span class="w-1 rounded-full bg-violet-500" style="height:6px"></span>
        <span class="w-1 rounded-full bg-violet-500" style="height:6px"></span>
        <span class="w-1 rounded-full bg-violet-500" style="height:6px"></span>
      </div>

      <p id="status" class="mb-6 hidden text-sm font-semibold text-slate-500">Listening...</p>

      <div id="hangupWrap" class="mb-6 hidden justify-center">
        <button
          id="hangupBtn"
          class="rounded-full border border-slate-300 bg-white px-6 py-2.5 text-sm font-semibold text-slate-700 disabled:cursor-not-allowed disabled:opacity-40"
        >
          End call
        </button>
      </div>

      <div id="transcript" class="flex max-h-80 flex-col gap-2 overflow-y-auto text-left"></div>
    </div>

    <p class="mt-6 rounded-2xl border border-slate-100 bg-slate-50 p-4 text-left text-xs leading-relaxed text-slate-500">
      Real voice in, real voice out via your browser's own speech recognition/synthesis &mdash;
      not Twilio's voice or a real phone call (see our <a href="/features" class="underline">features page</a>
      for how the real product works). Proves the conversation and RAG-grounding logic; a real
      call will sound different. Speech-to-text briefly sends your audio to your browser's own
      recognition service, so this needs an internet connection. Speaks English and Norwegian
      &mdash; just start talking in either one, or say "Norwegian" to switch.
    </p>
  </section>

  <script
    src="/voice-receptionist.js"
    data-api-url={import.meta.env.PUBLIC_API_URL}
    defer
  ></script>

  <style>
    @keyframes pulse-ring {
      0% { transform: scale(1); opacity: 0.35; }
      100% { transform: scale(1.6); opacity: 0; }
    }
    @keyframes wave {
      0%, 100% { height: 6px; }
      50% { height: 22px; }
    }
  </style>
</Layout>
