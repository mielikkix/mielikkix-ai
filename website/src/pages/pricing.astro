---
// Pricing hub: product switcher (Chat Widget selected by default) with the full
// <ProductPricing> block per product, Monthly/Yearly toggle, bundles and add-ons.
// Every number comes from src/data/pricing.ts.
import Layout from "../layouts/Layout.astro";
import CTASection from "../components/CTASection.astro";
import PageHero from "../components/PageHero.astro";
import Bi from "../components/pricing/Bi.astro";
import BillingToggle from "../components/pricing/BillingToggle.astro";
import ProductPricing from "../components/pricing/ProductPricing.astro";
import PricingLegalNote from "../components/pricing/PricingLegalNote.astro";
import {
  TIER_NAMES,
  addons,
  bundleListPrice,
  bundleSaving,
  bundles,
  formatNok,
  getProduct,
  products,
  yearlyPrice,
  type Lang,
} from "../data/pricing";
import { pricingProductNode } from "../lib/offeringSchema";
import en from "../assets/i18n/en/pricing.json";

const DEFAULT_PRODUCT = "chat-widget";
const visibleBundles = bundles.filter((b) => b.visible);
const langs: Lang[] = ["en", "no"];
---

<Layout
  title={en.SEO.TITLE}
  description={en.SEO.DESCRIPTION}
  path="/pricing"
  page="pricing"
  titleKey="SEO.TITLE"
  descriptionKey="SEO.DESCRIPTION"
  structuredDataNodes={[pricingProductNode("chat-widget", "/pricing")]}
>
  <PageHero
    line1={en.PAGE_HERO.LINE1}
    line2={en.PAGE_HERO.LINE2}
    subheading={en.PAGE_HERO.SUBHEADING}
    line1Key="PAGE_HERO.LINE1"
    line2Key="PAGE_HERO.LINE2"
    subheadingKey="PAGE_HERO.SUBHEADING"
  />

  <div class="mx-auto max-w-5xl px-6 pt-10">
    <p id="product-switcher-label" class="text-center text-xs font-semibold uppercase tracking-wide text-slate-400" data-i18n="SWITCHER_LABEL">
      {en.SWITCHER_LABEL}
    </p>
    <div role="tablist" aria-labelledby="product-switcher-label" class="mt-3 flex flex-wrap justify-center gap-2">
      {
        products.map((product) => (
          <button
            type="button"
            role="tab"
            id={`tab-${product.id}`}
            aria-controls={`panel-${product.id}`}
            aria-selected={product.id === DEFAULT_PRODUCT ? "true" : "false"}
            tabindex={product.id === DEFAULT_PRODUCT ? 0 : -1}
            data-product-tab={product.id}
            class="product-tab rounded-full border border-slate-200 bg-white px-4 py-1.5 text-sm font-medium text-slate-700"
          >
            <span aria-hidden="true">{product.emoji}</span> <Bi text={product.name} />
          </button>
        ))
      }
    </div>
    <div class="mt-6">
      <BillingToggle />
    </div>
  </div>

  {
    products.map((product) => (
      <div
        role="tabpanel"
        id={`panel-${product.id}`}
        aria-labelledby={`tab-${product.id}`}
        data-product-panel={product.id}
        hidden={product.id !== DEFAULT_PRODUCT}
      >
        <ProductPricing productId={product.id} />
      </div>
    ))
  }

  <!-- Bundles: price and saving computed from the list prices -->
  {
    visibleBundles.length > 0 && (
      <section class="border-t border-slate-100 bg-white py-14">
        <div class="mx-auto max-w-5xl px-6">
          <h2 class="text-center font-display text-3xl font-bold text-slate-900" data-i18n="BUNDLES.HEADING">
            {en.BUNDLES.HEADING}
          </h2>
          <p class="mx-auto mt-3 max-w-2xl text-center text-slate-500" data-i18n="BUNDLES.SUBHEADING">
            {en.BUNDLES.SUBHEADING}
          </p>
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            {visibleBundles.map((bundle) => (
              <div class="rounded-3xl border border-slate-300 bg-white p-7">
                <h3 class="font-display text-xl font-bold text-slate-900"><Bi text={bundle.name} /></h3>
                <p class="mt-1 text-sm text-slate-500"><Bi text={bundle.description} /></p>
                <ul class="mt-4 space-y-1.5 text-sm text-slate-700">
                  {bundle.parts.map((part) => (
                    <li>
                      ✓ <Bi text={getProduct(part.productId).name} /> <Bi text={TIER_NAMES[part.tierId]} />
                    </li>
                  ))}
                </ul>
                {langs.map((lang) => (
                  <div class={lang === "no" ? "i18n-no" : "i18n-en"}>
                    <p class="mt-5 font-display text-2xl font-extrabold text-slate-900">
                      <span class="billing-monthly">
                        {formatNok(bundle.priceNokMonthly, lang)}
                        {lang === "no" ? "/mnd eks. mva." : "/month excl. VAT"}
                      </span>
                      <span class="billing-yearly">
                        {formatNok(yearlyPrice(bundle.priceNokMonthly), lang)}
                        {lang === "no" ? "/år eks. mva." : "/year excl. VAT"}
                      </span>
                    </p>
                    <p class="mt-1 text-sm font-semibold text-emerald-600">
                      {lang === "no"
                        ? `Du sparer ${formatNok(bundleSaving(bundle), lang)}/mnd sammenlignet med å kjøpe dem hver for seg (${formatNok(bundleListPrice(bundle), lang)}/mnd).`
                        : `You save ${formatNok(bundleSaving(bundle), lang)}/month compared with buying them separately (${formatNok(bundleListPrice(bundle), lang)}/month).`}
                    </p>
                  </div>
                ))}
                <a href="/demo" class="brand-gradient mt-6 inline-block rounded-full px-5 py-2.5 text-sm font-semibold text-white">
                  <Bi text={{ en: "Book a demo", no: "Book en demo" }} />
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Add-ons -->
  <section class="mx-auto max-w-5xl px-6 py-12">
    <h2 class="text-center font-display text-2xl font-bold text-slate-900" data-i18n="ADDONS.HEADING">{en.ADDONS.HEADING}</h2>
    <div class="mx-auto mt-6 max-w-xl space-y-4">
      {
        addons.map((addon) => (
          <div class="flex items-start justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-5">
            <div>
              <h3 class="font-semibold text-slate-900"><Bi text={addon.name} /></h3>
              <p class="mt-1 text-sm text-slate-500"><Bi text={addon.description} /></p>
            </div>
            <p class="shrink-0 text-sm font-semibold text-slate-700">
              {addon.comingSoon ? (
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs"><Bi text={{ en: "Coming soon", no: "Kommer snart" }} /></span>
              ) : (
                langs.map((lang) => (
                  <span class={lang === "no" ? "i18n-no" : "i18n-en"}>
                    {formatNok(addon.priceNokMonthly, lang)}
                    {lang === "no" ? "/mnd eks. mva." : "/month excl. VAT"}
                  </span>
                ))
              )}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <PricingLegalNote />

  <CTASection heading={en.CTA.HEADING} subheading={en.CTA.SUBHEADING} headingKey="CTA.HEADING" subheadingKey="CTA.SUBHEADING" />
</Layout>

<style>
  .product-tab[aria-selected="true"] {
    border-color: var(--color-violet-600, #7c3aed);
    background: var(--color-violet-600, #7c3aed);
    color: #fff;
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-product-tab]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-product-panel]"));

  function select(id: string, focus = false) {
    if (!tabs.some((t) => t.dataset.productTab === id)) return;
    tabs.forEach((tab) => {
      const on = tab.dataset.productTab === id;
      tab.setAttribute("aria-selected", String(on));
      tab.tabIndex = on ? 0 : -1;
      if (on && focus) tab.focus();
    });
    panels.forEach((panel) => (panel.hidden = panel.dataset.productPanel !== id));
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => {
      select(tab.dataset.productTab!);
      history.replaceState(null, "", `#${tab.dataset.productTab}`);
    });
    // Arrow-key navigation between tabs (WAI-ARIA tabs pattern).
    tab.addEventListener("keydown", (e) => {
      const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      select(tabs[(i + step + tabs.length) % tabs.length].dataset.productTab!, true);
    });
  });

  // /pricing#voice-receptionist opens that product.
  if (location.hash) select(location.hash.slice(1));
</script>
