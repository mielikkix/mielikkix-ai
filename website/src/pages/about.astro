---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import en from "../assets/i18n/en/company.json";

// QA 2026-10-05 (BUG-14): /about returned a stock 404. Copy follows
// marketing/Mielikkix-AI-About.docx, minus anything not yet true on the
// site (no "AS" until the company registration completes -- see Layout.astro's
// structured-data note). /company redirects here (public/.htaccess).
const a = en.ABOUT;
const sections = [
  ["WHO_HEADING", "WHO_TEXT"],
  ["NAME_HEADING", "NAME_TEXT"],
  ["PROBLEM_HEADING", "PROBLEM_TEXT"],
  ["SOLUTION_HEADING", "SOLUTION_TEXT"],
  ["TRUST_HEADING", "TRUST_TEXT"],
] as const;
---

<Layout
  title={a.SEO.TITLE}
  description={a.SEO.DESCRIPTION}
  path="/about/"
  page="company"
  titleKey="ABOUT.SEO.TITLE"
  descriptionKey="ABOUT.SEO.DESCRIPTION"
>
  <PageHero
    line1={a.HERO_LINE1}
    line2={a.HERO_LINE2}
    subheading={a.SUBHEADING}
    line1Key="ABOUT.HERO_LINE1"
    line2Key="ABOUT.HERO_LINE2"
    subheadingKey="ABOUT.SUBHEADING"
  />

  <section class="mx-auto max-w-3xl px-6 py-16">
    <div class="space-y-10">
      {
        sections.map(([heading, text]) => (
          <div>
            <h2 class="font-display text-2xl font-bold text-slate-900" data-i18n={`ABOUT.${heading}`}>
              {a[heading]}
            </h2>
            <p class="mt-3 leading-relaxed text-slate-600" data-i18n={`ABOUT.${text}`}>
              {a[text]}
            </p>
          </div>
        ))
      }
    </div>

    <div class="mt-14 rounded-3xl border border-slate-100 bg-white p-8 text-center shadow-sm">
      <h2 class="font-display text-xl font-bold text-slate-900" data-i18n="ABOUT.CONTACT_HEADING">{a.CONTACT_HEADING}</h2>
      <p class="mt-2 text-slate-500" data-i18n="ABOUT.CONTACT_TEXT">{a.CONTACT_TEXT}</p>
      <p class="mt-3">
        <a href="mailto:post@mielikkix.no" class="font-semibold text-violet-600 hover:text-violet-700">post@mielikkix.no</a>
      </p>
      <a
        href="/contact/"
        data-i18n="ABOUT.CONTACT_BUTTON"
        class="brand-gradient mt-5 inline-block rounded-full px-6 py-2.5 text-sm font-semibold text-white"
      >
        {a.CONTACT_BUTTON}
      </a>
    </div>
  </section>
</Layout>
